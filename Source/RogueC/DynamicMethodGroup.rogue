library RogueC

class DynamicMethodGroup
  PROPERTIES
    methods         = Method[]
    method_lookup   = [Type:Method]
    exception_types = [Type:ExceptionTypes]
    is_used         : Logical

  METHODS
    method init( m:Method )
      add( m )

    method add( m:Method )
      if (m.attributes.is_collected) return
      methods.add( m )
      m.attributes.is_collected = true

      method_lookup[m.type_context] = m

      if local entry = exception_types.find( m.type_context )
        entry.value |= m.throws
      else
        exception_types[m.type_context] = m.throws
      endIf

    method mark_uncollected
      (forEach in methods).attributes.is_collected = false

    method throws_for_context( context_type:Type )->ExceptionTypes
      local throws : ExceptionTypes

      forEach (value at key in exception_types)
        if (key.instance_of(context_type))
          throws |= value
          throws |= method_lookup[key].throws
        endIf
      endForEach

      forEach (entry in exception_types.entries)
        if (entry.key.instance_of(context_type)) entry.value |= throws
      endForEach

      return throws

    method to->String
      return methods->String
endClass
