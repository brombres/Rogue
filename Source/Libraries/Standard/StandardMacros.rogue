$macro ROGUE_NATIVE_POINTER_TYPE<<$NativeType,$Name>>
  nativeType<<$NativeType>>  $Name

  augment Rogue::$Name
    GLOBAL METHODS
      method operator?( obj:$Name )->Logical
        return obj.exists

    METHODS
      method exists->Logical
        return native("!!$this.value")->Logical
  endAugment
$endMacro

# Deprecated
$macro NATIVE_POINTER_TYPE<<$Name,$NativeType>>
  nativeType<<$NativeType>>  $Name

  augment Rogue::$Name
    GLOBAL METHODS
      method operator?( obj:$Name )->Logical
        return obj.exists

    METHODS
      method exists->Logical
        return native("!!$this.value")->Logical
  endAugment
$endMacro

$define Value Variant

# SingletonState example usage
#   class SingletonState<<GamePhase>>
#   endClass
#
#   class SingletonState<<GamePhase,Alpha>>
#     METHODS
#       method on_start
#         trace
#
#       method on_finish
#         trace
#   endClass
#
#   class SingletonState<<GamePhase,Bravo>>
#     METHODS
#       method on_start
#         trace
#
#       method on_finish
#         trace
#   endClass
#
#   trace GamePhase.states.keys
#   GamePhase = Alpha
#   GamePhase = Bravo
#   GamePhase = Alpha
$macro SingletonState<<$Type>>
  $Type [singleton]
    GLOBAL PROPERTIES
      states = [String:GamePhase]

    GLOBAL METHODS
      method create( name:String )->$Type
        if local existing = states[name]
          return existing
        else
          local result = $Type()
          states[name] = result
          return result
        endIf

      method on_singleton_change( old_value:$Type, new_value:$Type )
        if (old_value) old_value.on_finish
        if (new_value) new_value.on_start

    METHODS
      method init
        noAction

      method init_object
        states[type_name] = this

      method on_start

      method on_finish
$endMacro

$macro SingletonState<<$Type,$StateName>>
  $StateName : $Type [essential singleton]
$endMacro
