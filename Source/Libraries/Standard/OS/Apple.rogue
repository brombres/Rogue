nativeType<<"NSSearchPathDirectory">> RogueNSSearchPathDirectory

class Apple [singleton]
  METHODS
    method application_data_folder->File
      return find_system_folder( RogueNSSearchPathDirectory("NSLibraryDirectory") )

    method cache_folder->File
      return find_system_folder( RogueNSSearchPathDirectory("NSCachesDirectory") )

    method current_language_code->String
      # E.g. "en" or "es" (not "es-MX" etc.).
      local result : String
      native @|NSString *code = [[NSLocale currentLocale] objectForKey:NSLocaleLanguageCode];
              |$result = %Ns%Rogue_ns_string_to_string( code );
      return result

    method find_system_folder( type:RogueNSSearchPathDirectory )->File
      local filepath : String

      if (System.is_apple)
        native
        @|NSString *path = Rogue_find_ns_folder( $type.value );
         |$filepath = Rogue_ns_string_to_string( path );
      endIf

      if (filepath) return File( filepath )
      else          return File( "~" )

    method user_data_folder->File
      return find_system_folder( RogueNSSearchPathDirectory("NSDocumentDirectory") )

  NATIVE
    nativeHeader
    @|#if defined(%NS%ROGUE_TARGET_APPLE)
     |  #if __has_include(<Cocoa/Cocoa.h>)
     |    #import <Cocoa/Cocoa.h>
     |  #else
     |    #import <Foundation/Foundation.h>
     |  #endif
     |  NSString*    %Ns%Rogue_string_to_ns_string( RogueString* st );
     |  RogueString* %Ns%Rogue_ns_string_to_string( NSString* st );
     |  NSString*    %Ns%Rogue_find_ns_folder( NSSearchPathDirectory type );
     |#endif

    nativeCode
    @|#if defined(%NS%ROGUE_TARGET_APPLE)
     |  NSString* %Ns%Rogue_string_to_ns_string( RogueString* st )
     |  {
     |    if ( !st ) return nil;
     |    return [NSString stringWithUTF8String:(const char*)st->data->as_utf8];
     |  }
     |
     |  RogueString* %Ns%Rogue_ns_string_to_string( NSString* st )
     |  {
     |    if ( !st ) return 0;
     |
     |    return %Ns%RogueString_create( [st UTF8String] );
     |  }
     |
     |  NSString* %Ns%Rogue_find_ns_folder( NSSearchPathDirectory type )
     |  {
     |    return NSSearchPathForDirectoriesInDomains(
     |      type,
     |      NSUserDomainMask,
     |      YES
     |    ).firstObject;
     |  }
     |#endif
endClass
