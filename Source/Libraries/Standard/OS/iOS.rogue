class iOS : Apple [singleton]
  METHODS
    method induce_memory_warning
      native
      @|#if defined(%NS%ROGUE_TARGET_IOS)
       |  NSMutableArray<NSValue *> *blocks = [NSMutableArray array];
       |  const size_t kChunk = 128 * 1024 * 1024; // 128 MB
       |  const size_t kMinHeadroom = 60 * 1024 * 1024; // leave ~60 MB
       |
       |  for (;;)
       |  {
       |      size_t avail = os_proc_available_memory(); // iOS 13+
       |      os_log( OS_LOG_DEFAULT, "mem: %zu bytes available", avail );
       |      if (avail < kMinHeadroom)
       |      {
       |        os_log( OS_LOG_DEFAULT, "[induce_memory_warning] minimum headroom reached" );
       |        break;
       |      }
       |
       |      void *p = malloc( kChunk );
       |      if (!p)
       |      {
       |        os_log( OS_LOG_DEFAULT, "[induce_memory_warning] malloc failed" );
       |        break;
       |      }
       |
       |      // Touch a page so it's backed
       |      memset(p, 0, 4096);
       |      [blocks addObject:[NSValue valueWithPointer:p]];
       |  }
       |
       |  for (NSValue *val in blocks)
       |  {
       |      void *p = [val pointerValue];
       |      free(p);
       |  }
       |  os_log( OS_LOG_DEFAULT, "[induce_memory_warning] pressure allocations released" );
       |#endif

    method request_review
      native
      @|#if defined(%NS%ROGUE_TARGET_IOS)
       |  for (UIScene *scene in UIApplication.sharedApplication.connectedScenes)
       |  {
       |    if (scene.activationState == UISceneActivationStateForegroundActive && [scene isKindOfClass:[UIWindowScene class]])
       |    {
       |      [SKStoreReviewController requestReviewInScene:(UIWindowScene *)scene];
       |      break;
       |    }
       |  }
       |#endif

  NATIVE
    nativeHeader
    @|#if defined(%NS%ROGUE_TARGET_IOS)
     |  #import <StoreKit/StoreKit.h>
     |  #import <UIKit/UIKit.h>
     |  #import <os/log.h>
     |  #import <os/proc.h> // os_proc_available_memory()
     |#endif

endClass
