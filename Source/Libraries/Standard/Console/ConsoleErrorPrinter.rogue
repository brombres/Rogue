class ConsoleErrorPrinter : BufferedPrintWriter<<output_buffer>>
  METHODS
    method flush( buffer:String )
      write( buffer )
      buffer.clear

    method write( value:String )
      native @|#if defined(%NS%ROGUE_TARGET_ANDROID)
              |  __android_log_print( ANDROID_LOG_ERROR, "%Ns%Rogue", "%s", $value->data->as_utf8 );
              |#elif defined(%NS%ROGUE_TARGET_WEB)
              |  %Ns%Rogue_web_write( (char*)$value->data->as_utf8, $value->data->count, STDERR_FILENO );
              |#else
              |  #if defined(%NS%ROGUE_TARGET_IOS)
              |    os_log_error( OS_LOG_DEFAULT, "%{public}s", $value->data->as_utf8 );
              |  #else
              |    %Ns%Rogue_fwrite( (char*)$value->data->as_utf8, $value->data->count, STDERR_FILENO );
              |  #endif
              |#endif

endClass
