# EXAMPLE
#   uses Codec/WAV
#
#   local wav = WAV( File("Test.wav") )
#   println wav
#   # 1 channel 24-bit PCM 96000 Hz (for example)
#
#   (forEach in wav.channels).samples.reverse
#
#   wav.save( File("Test-reversed.wav") )

$include IO/DataIO

class WAV
  GLOBAL METHODS
    method silence( duration:Real, format:WAVFormat )->WAV
      local result = WAV( format )
      local sample_count = (format.sample_rate * duration).round->Int
      loop (format.channel_count)
        local samples = Dim<<Real32>>( sample_count )
        result.channels.add( WAVChannel(result,samples) )
      endLoop
      return result

  PROPERTIES
    channels    = WAVChannel[](2)
    encoding    : WAVEncoding
    bit_depth   : Int
    sample_rate : Int
    page_align  : Logical
    error       : String

  METHODS
    method init( file:File )
      if (not WAVDecoder.decode(DataReader(file),this))
        error = "Error decoding WAV file: $"(file.filepath)
      endIf

    method init( format:WAVFormat )
      this.encoding = format.encoding
      this.bit_depth = format.bit_depth
      this.sample_rate = format.sample_rate
      this.page_align = format.page_align
      validate

    method count->Int
      # Returns sample count.
      if (channels.is_empty) return 0
      return channels.first.count

    method create_channel->WAVChannel
      local channel = WAVChannel( this )
      channels.add( channel )
      return channel

    method format->WAVFormat
      return WAVFormat( channels.count, encoding, bit_depth, sample_rate, page_align )

    method locate_silence( i1=0:Int, &threshold=0.01:Real, &min_duration=0.1:Real )->Int?
      # Returns the index of the next sample at or after 'i1' where every channel is silent,
      # or null if there is no such sample.
      #
      # threshold    - Absolute amplitude (0.0-1.0) below which a sample is considered quiet.
      # min_duration - Minimum length in seconds of a quiet stretch for it to count as silence.
      if (channels.is_empty) return null

      local i = i1
      loop
        # Find the latest point at which any channel's next silence begins...
        local result : Int?
        forEach (channel in channels)
          local index = channel.locate_silence( i, &=threshold, &=min_duration )
          if (not index) return null
          if (not result or index.value > result.value) result = index
        endForEach

        # ...then make sure every channel is actually silent at that point.
        local all_silent = true
        forEach (channel in channels)
          if (channel.locate_silence(result.value,&=threshold,&=min_duration) != result)
            all_silent = false
            escapeForEach
          endIf
        endForEach
        if (all_silent) return result

        i = result.value
      endLoop

    method locate_sound( i1=0:Int, &threshold=0.01:Real, &min_duration=0.1:Real )->Int?
      # Returns the index of the next sample at or after 'i1' where any channel is
      # non-silent, or null if there is no such sample. See locate_silence() for
      # the meaning of 'threshold' and 'min_duration'.
      local result : Int?
      forEach (channel in channels)
        if local index = channel.locate_sound( i1, &=threshold, &=min_duration )
          if (not result or index < result.value) result = index
        endIf
      endForEach
      return result

    method operator+( other:WAV )->WAV
      local a_channels = channels.cloned
      local b_channels = other.channels.cloned
      while (a_channels.count != b_channels.count)
        if (a_channels.count < b_channels.count) a_channels.add( a_channels.last )
        else                   b_channels.add( b_channels.last )
      endWhile

      localize format
      format.channel_count = a_channels.count
      local result = WAV( format )

      forEach (index of a_channels)
        local left  = a_channels[index]
        local right = b_channels[index]
        local spliced_samples = Real32[]( left.count + right.count )
        spliced_samples.add( left.samples )
        spliced_samples.add( right.samples )
        result.channels.add( WAVChannel(result,spliced_samples) )
      endForEach

      return result

    method save( file:File )->Logical
      if (not validate) return false
      return file.save( WAVEncoder.encode(this) )

    method subset( i1:Int )->WAV
      return subset( i1, count - i1 )

    method subset( i1:Int, n:Int )->WAV
      local result = WAV( this.format )
      forEach (channel in channels)
        result.channels.add( WAVChannel(result,channel.samples.subset(i1,n)) )
      endForEach
      return result

    method subset( span:Span )->WAV
      return subset( span.index, span.count )

    method to->String
      return "$ channel $-bit $ $ Hz" (channels.count,bit_depth,encoding,sample_rate)

    method validate->Logical
      which (encoding)
        case PCM
          which (bit_depth)
            case 8, 16, 24, 32
              noAction
            others
              error = "WAV does not support $-bit PCM."(bit_depth)
          endWhich
        case IEEE_FLOAT
          if (bit_depth != 32)
            error = "WAV does not support $-bit floating point."(bit_depth)
          endIf
        others
          error = "WAV cannot handle encoding $."(encoding)
      endWhich
      return not error
endClass

class WAVChannel
  PROPERTIES
    wav       : WAV
    samples   : Real32[]

  METHODS
    method init( wav, samples=Real32[] )

    method add( sample:Real )
      samples.add( sample )

    method count->Int
      return samples.count

    method locate_silence( i1=0:Int, &threshold=0.01:Real, &min_duration=0.1:Real )->Int?
      # Returns the index of the next sample at or after 'i1' that is part of a
      # silent region, or null if there is no such sample.
      #
      # A sample is silent if it belongs to a run of at least 'min_duration'
      # seconds of consecutive samples whose absolute amplitude is below
      # 'threshold'. Audible sound crosses zero constantly, so brief
      # near-zero dips within a sound are not considered silence.
      local n = samples.count
      if (i1 >= n) return null
      local min_samples = min_duration_to_samples( min_duration )

      # If 'i1' is already inside a quiet run, the run may have started before it.
      local run_start = i1
      while (run_start > 0 and samples[run_start-1].abs < threshold) --run_start

      local i = i1
      while (i < n)
        if (samples[i].abs < threshold)
          if ((i - run_start) + 1 >= min_samples) return run_start.or_larger( i1 )
        else
          run_start = i + 1
        endIf
        ++i
      endWhile

      return null

    method locate_sound( i1=0:Int, &threshold=0.01:Real, &min_duration=0.1:Real )->Int?
      # Returns the index of the next sample at or after 'i1' that is part of a
      # non-silent region, or null if there is no such sample. See
      # locate_silence() for the meaning of 'threshold' and 'min_duration'.
      local n = samples.count
      if (i1 >= n) return null
      local min_samples = min_duration_to_samples( min_duration )

      # Find the next sample at or above the threshold.
      local i = i1
      while (i < n and samples[i].abs < threshold) ++i
      if (i == i1) return i1

      # Samples [i1,i) are quiet. They are still "sound" if the quiet run
      # they belong to is too short to count as silence.
      local run_start = i1
      while (run_start > 0 and samples[run_start-1].abs < threshold) --run_start
      if (i - run_start < min_samples) return i1

      if (i >= n) return null
      return i

    method min_duration_to_samples( min_duration:Real )->Int
      local result = (min_duration * wav.sample_rate)->Int
      return result.or_larger( 1 )

    method get( index:Int )->Real
      return samples[index]

    method read( reader:DataReader )
      which (wav.encoding)
        case PCM
          which (wav.bit_depth)
            case 8
              local sample = reader.read : Int
              samples.add( (sample - 128) / 128.0 )
            case 16
              local sample = reader.read_int16_low_high
              if (sample & 0x8000) sample -= 65536
              samples.add( sample / 32768.0 )
            case 24
              local sample = reader.read_int16_low_high
              sample = (reader.read->Int :<<: 16) | sample
              if (sample & 0x80_0000) sample -= 0x100_0000
              samples.add( sample / 8388608.0 )
            others
              samples.add( reader.read_int32_low_high / 2147483648.0 )
          endWhich
        case IEEE_FLOAT
          local sample = reader.read_int32_low_high.real_bits
          samples.add( sample.clamped(-1.0,1.0) )
      endWhich

    method write( index:Int, writer:DataWriter )
      which (wav.encoding)
        case PCM
          which (wav.bit_depth)
            case 8
              writer.write( (samples[index]*128.0).round.clamped(-128.0,127.0)->Int + 128 )
            case 16
              writer.write_int16_low_high( (samples[index]*32768.0).round.clamped(-32768.0,32767.0)->Int )
            case 24
              local sample = (samples[index]*8388608.0).round.clamped(-8388608.0,8388607.0)->Int
              writer.write_int16_low_high( sample )
              writer.write( sample:>>>:16 )
            others
              writer.write_int32_low_high( (samples[index]*2147483648.0).round.clamped(-2147483648.0,2147483647.0)->Int )
          endWhich
        case IEEE_FLOAT
          writer.write_int32_low_high( samples[index]->Real32.integer_bits )
      endWhich
endClass

class WAVFormat( channel_count:Int, encoding:WAVEncoding, bit_depth:Int, sample_rate:Int, page_align:Logical ) [compound]
endClass

class WAVDecoder [singleton]
  # http://www-mmsp.ece.mcgill.ca/Documents/AudioFormats/WAVE/WAVE.html
  # http://tiny.systems/software/soundProgrammer/WavFormatDocs.pdf
  PROPERTIES
    reader : DataReader
    wav    : WAV

  METHODS
    method decode( reader, wav )->Logical
      if (reader.read_int32 != 0x52494646) return false  # "RIFF"
      reader.read_int32_low_high                             # chunk size
      if (reader.read_int32 != 0x57415645) return false  # "WAVE"
      if (reader.read_int32 != 0x666D7420) return false  # "fmt "
      if (reader.read_int32_low_high != 16) return false     # subchunk 1 size

      wav.encoding = WAVEncoding( reader.read_int16_low_high )
      if (not wav.encoding.exists) return false

      local channel_count = reader.read_int16_low_high

      wav.sample_rate = reader.read_int32_low_high

      reader.read_int32_low_high  # data rate
      reader.read_int16_low_high  # block size in bytes

      wav.bit_depth = reader.read_int16_low_high
      if (not wav.validate) return false

      loop (channel_count) wav.create_channel

      while (reader.has_another)
        read_another_chunk
      endWhile

      return true

    method read_another_chunk
      local id = reader.read_int32
      local size = reader.read_int32_low_high

      which (id)
        case 0x64617461   # "data"
          local n = size / ((wav.bit_depth / 8) * wav.channels.count)
          (forEach in wav.channels).samples.reserve( n )
          loop (n)
            (forEach in wav.channels).read( reader )
          endLoop

        case 0x464C4C52   # "FLLR"
          # A FLLR chunk aligns the read position to a multiple of 4096 minus 8
          # so that the content of the data chunk is 4K page-aligned.
          wav.page_align = true
          reader.skip( size )

        others            # Unknown chunk type
          #println "Unknown chunk type: $" (id_to_string(id))
          reader.skip( size )
      endWhich

    method id_to_string( id:Int )->String
      local a = (id:>>>:24)->Byte->Character
      local b = (id:>>>:16)->Byte->Character
      local c = (id:>>>:8)->Byte->Character
      local d = id->Byte->Character
      return "$$$$"(a,b,c,d)
endClass

class WAVEncoder [singleton]
  METHODS
    method encode( wav:WAV )->Byte[]
      local writer = DataWriter()

      writer.write_int32( 0x52494646 )  # "RIFF"
      writer.write_int32_low_high( encoded_size(wav) - 8 )
      writer.write_int32( 0x57415645 )  # "WAVE"
      writer.write_int32( 0x666D7420 )  # "fmt "

      writer.write_int32_low_high( 16 )                 # subchunk 1 size
      writer.write_int16_low_high( wav.encoding->Int )  # encoding

      writer.write_int16_low_high( wav.channels.count ) # channel count
      writer.write_int32_low_high( wav.sample_rate )    # sample rate

      writer.write_int32_low_high( wav.sample_rate * (wav.bit_depth/8) * wav.channels.count )
      writer.write_int16_low_high( (wav.bit_depth/8) * wav.channels.count )
      writer.write_int16_low_high( wav.bit_depth )

      if (wav.page_align)
        # FLLR chunk to make data start on a 4K boundary
        writer.write_int32( 0x464C4C52 )    # "FLLR"
        writer.write_int32_low_high( 4044 )
        loop (4044) writer.write(0)
      endIf

      writer.write_int32( 0x64617461 )  # "data"
      local sample_count = which{ wav.channels.count:wav.channels.first.count || 0 }
      writer.write_int32_low_high( sample_count * (wav.bit_depth/8) * wav.channels.count )  # chunk size
      forEach (i in 0..<sample_count)
        (forEach in wav.channels).write( i, writer )
      endForEach

      return writer.output_bytes


    method encoded_size( wav:WAV )->Int
      local size = 36  # header
      size += 8        # "data" chunk header
      if (wav.page_align) size += 4052 # FLLR chunk to make data start on a 4K boundary
      if (wav.channels.count)
        size += wav.channels.count * (wav.bit_depth / 8) * wav.channels.first.count
      endIf
      return size
endClass

enum WAVEncoding
  PCM        = 0x0001
  IEEE_FLOAT = 0x0003
  ALAW       = 0x0006   # 8-bit ITU-T G.711 A-law
  MULAW      = 0x0007   # 8-bit ITU-T G.711 µ-law
  EXTENSIBLE = 0xFFFE   # Determined by SubFormat

  METHODS
    method exists->Logical
      return categories.contains(this)
endEnum

