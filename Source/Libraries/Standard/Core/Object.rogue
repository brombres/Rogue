class Object
  GLOBAL METHODS
    method __type_name( type_index:Int )->String [essential]
      if (native("!%Ns%Rogue_types[$type_index]->name_object")->Logical)
        native @|%Ns%Rogue_types[$type_index]->name_object = %Ns%RogueString_create_permanent( %Ns%Rogue_types[$type_index]->name );
      endIf
      return native("%Ns%Rogue_types[$type_index]->name_object")->String

  METHODS
    method description->String
      return this->String

    method hashcode->Int
      return object_id->Int

    method hash_code->Int32  # deprecated in favor of .hashcode()
      return hashcode

    method object_id->Int64
      local addr : Int64
      native "$addr = (%Ns%RogueInt64)(void*)$this;"
      return addr

    method object_refcount->Int
      return native("$this->__refcount;")->Int32

    method operator==( other:Object )->Logical
      return this is other

    method poison_object
      native
      @|#if %NS%ROGUE_ENABLE_GC_POISON
       |  $this->__poison_level = 1;
       |#endif

    method print_to( buffer:PrintWriter )
      buffer.print( this->String )

    method release_object
      # Increments an internal reference count. When the reference count reaches zero
      # and this object is no longer visible to Rogue, it will be garbage-collected
      # at some future point. This call does not itself trigger a garbage collection.
      native @|ROGUE_RELEASE( $this );

    method retain_object
      # Increments an internal reference count that prevents this object from being
      # garbage-collected when no longer visible to Rogue.
      native @|ROGUE_RETAIN( $this );

    method to->String
      return type_name

    method to->Variant
      return Variant( this )

endClass

