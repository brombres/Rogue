class Span( index:Int, count:Int ) [compound]
  METHODS
    method i2->Int
      return index + (count-1)

    method limit->Int
      return index + count

    method to->String
      return "@$ x$"(index,count)

    method unleft( n:Int )->Span
      if (count <= n) return Span( index+count, 0 )
      else            return Span( index+n, count-n )

    method unright( n:Int )->Span
      if (count <= n) return Span( index, 0 )
      else            return Span( index, count-n )
endClass
