class Boxed [abstract]
  METHODS
    method size->Int  [abstract]

    method to->String
      return description

endClass

class Boxed<<$DataType>>( value:$DataType ) : Boxed
  METHODS
    method description->String
      return value->String

    method size->Int
      return native( "(%Ns%RogueInt)(%Ns%RogueInt)sizeof($value)" )->Int

    method to->$DataType
      return value

endClass

