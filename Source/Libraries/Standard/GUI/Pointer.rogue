library GUI

class PointerPosition( id:Int, position:XY ) [compound];

class Pointer [singleton]
  PROPERTIES
    position      : XY?   # of first touch in current single touch or multitouch event
    presses       = PointerPosition[]
    is_multitouch : Logical

  METHODS
    method average_position->XY?
      if (presses.is_empty) return null
      local sum : XY
      sum += (forEach in presses).position
      return sum / presses.count

    method find( by_id:Int )->PointerPosition?
      forEach (press in presses)
        if (press.id == by_id) return press
      endForEach
      return null

    method locate( by_id:Int )->Int?
      forEach (press at i in presses)
        if (press.id == by_id) return i
      endForEach
      return null

    method record( e:PointerEvent )
      if (e.is_press)
        presses.add( PointerPosition(e.pointer_id, e.position) )
        if (presses.count == 1) position = e.position
        else                           is_multitouch = true
        e.is_multitouch = is_multitouch

      elseIf (e.is_move)
        local new_position = PointerPosition( e.pointer_id, e.position )
        which (presses.count)
          case 0
            # Shouldn't happen
            position = e.position
          case 1
            position = e.position
            presses[0] = new_position
          others
            if local i = locate( e.pointer_id )
              presses[i] = new_position
              if (i == 0) position = e.position
            endIf
        endWhich
        e.is_multitouch = is_multitouch

      elseIf (e.is_release)
        which (presses.count)
          case 0
            # shouldn't happen
            position = e.position
          case 1
            position = e.position
            presses.remove_last
          others
            if local i = locate( e.pointer_id )
              presses.remove_at( i )
            endIf
        endWhich
        e.is_multitouch = is_multitouch
        if (presses.is_empty) is_multitouch = false

      elseIf (e.is_leave)
        position = null
        presses.clear
        e.is_multitouch = false

      endIf

endClass
