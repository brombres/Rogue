library UI

uses Geometry

class Natural( value:Real ) [compound]
  # A natural (intrinsic) size such as the unscaled pixel size of an image
  # or the default size of text rendered in a given font.
  METHODS
    method to->Real
      return value
endClass

class NaturalXY( value:XY ) [compound]
  # A natural (intrinsic) size such as the unscaled pixel size of an image
  # or the default size of text rendered in a given font.
  GLOBAL METHODS
    method create( x:Real, y:Real )->NaturalXY
      return NaturalXY( XY(x,y) )

  METHODS
    method to->XY
      return value
endClass
