library UI

uses Geometry

class Natural( value:Real ) [compound]
  # A size in logical (density-independent) coordinates. Automatically
  # multiplied by UI.display_density when converted to pixels.
  METHODS
    method to->Real
      return value
endClass

class NaturalXY( value:XY ) [compound]
  # A size in logical (density-independent) coordinates. Automatically
  # multiplied by UI.display_density when converted to pixels.
  GLOBAL METHODS
    method create( x:Real, y:Real )->NaturalXY
      return NaturalXY( XY(x,y) )

  METHODS
    method to->XY
      return value
endClass
