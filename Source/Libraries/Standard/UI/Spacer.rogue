library UI

class Spacer : Component
  GLOBAL METHODS
    method create( fixed_size:XY )->Spacer
      return Spacer().[ fixed_size=fixed_size ]

    method create( fixed_point_size:PointsXY )->Spacer
      return Spacer().[ fixed_size=fixed_point_size ]

    method create( size_parameter_id:VariantEntryID )->Spacer
      return Spacer().[ size = size_parameter_id ]

    method h->Spacer
      return Spacer().[ fixed_width=0 ]

    method h( height:Real )->Spacer
      return Spacer().[ fixed_width=0, fixed_height=height ]

    method h( height:Points )->Spacer
      return Spacer().[ fixed_width=0, fixed_height=height ]

    method h( height_parameter_id:VariantEntryID )->Spacer
      return Spacer().[ height = height_parameter_id ]

    method w->Spacer
      return Spacer().[ fixed_height=0 ]

    method w( width:Real )->Spacer
      return Spacer().[ fixed_width=width, fixed_height=0 ]

    method w( width:Points )->Spacer
      return Spacer().[ fixed_width=width, fixed_height=0 ]

    method w( width_parameter_id:VariantEntryID )->Spacer
      return Spacer().[ width = width_parameter_id ]

  METHODS
    method init
      prior.init

endClass
