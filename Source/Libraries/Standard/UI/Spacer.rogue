library UI

class Spacer : Component
  GLOBAL METHODS
    method create( fixed_size:XY )->Spacer
      return Spacer().[ fixed_size=fixed_size ]

    method create( fixed_point_size:PointsXY )->Spacer
      return Spacer().[ fixed_size=fixed_point_size ]

    method create( size_parameter_id:VariantEntryID )->Spacer
      return Spacer().[ fixed_size = size_parameter_id ]

    method height->Spacer
      return Spacer().[ fixed_width=0 ]

    method height( height:Real )->Spacer
      return Spacer().[ fixed_width=0, fixed_height=height ]

    method height( height:Points )->Spacer
      return Spacer().[ fixed_width=0, fixed_height=height ]

    method height( height_parameter_id:VariantEntryID )->Spacer
      return Spacer().[ fixed_height = height_parameter_id ]

    method width->Spacer
      return Spacer().[ fixed_height=0 ]

    method width( width:Real )->Spacer
      return Spacer().[ fixed_width=width, fixed_height=0 ]

    method width( width:Points )->Spacer
      return Spacer().[ fixed_width=width, fixed_height=0 ]

    method width( width_parameter_id:VariantEntryID )->Spacer
      return Spacer().[ fixed_width = width_parameter_id ]

  METHODS
    method init
      prior.init

endClass
