library UI

uses Geometry

class Aspect( value:XY ) [compound]
  # An aspect ratio for ASPECT_FIT sizing. The dimension it is assigned to
  # is scaled to maintain this ratio relative to the other dimension.
  GLOBAL METHODS
    method create( x:Real, y:Real )->Aspect
      return Aspect( XY(x,y) )

  METHODS
    method to->XY
      return value
endClass
