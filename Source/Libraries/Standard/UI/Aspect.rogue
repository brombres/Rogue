library UI

uses Geometry

class Aspect( value:XY ) [compound]
  # A size in logical (density-independent) coordinates. Automatically
  # multiplied by UI.display_density when converted to pixels.
  GLOBAL METHODS
    method create( x:Real, y:Real )->Aspect
      return Aspect( XY(x,y) )

  METHODS
    method to->XY
      return value
endClass
