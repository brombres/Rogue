library UI

class HFlow : Component
  PROPERTIES
    layout_finished  : Logical
    layout_cursor    : XY
    max_width        : Real
    cur_line_height  : Real
    cur_line_advance : Real

  METHODS
    method init
      noAction

    method init( component:Component )
      prior.init( component )

    method init( text:String )
      add( Text(text) )

    method minimum_layout_size( available_size:XY, &limited )->XY [override]
      resolve_content_layout_sizes

      if (sizing_mode.x == SizingMode.SHRINK_TO_FIT) size.x = available_size.x
      perform_layout( XY.zero )

      return layout_cursor

    method on_begin_layout [override]
      layout_finished = false
      prior.on_begin_layout

    method on_end_layout [override]
      localize content_alignment
      if (content_alignment == Anchor.TOP_LEFT) return

      use components = display_components
        # If the content alignment is not TOP_LEFT, adjust content positions to match.
        local snap = UI.snap_to_pixel_coordinates
        localize content_size

        if (content_alignment.position.y > 0)
          # Apply same vertical adjustment to all components.
          local delta = XY( 0, (content_size.y - layout_cursor.y) * content_alignment.position.y )
          if (snap) delta .= floor
          forEach (component in components)
            component.position += delta
          endForEach
        endIf

        if (content_alignment.position.x > 0)
          # Horizontal adjustment needs to go row by row.
          use row = WorkList<<Component,Row>>
            local component_i = 0
            while (component_i < components.count)
              row.clear
              local row_w = 0.0
              local row_y = components[component_i].position.y
              while (component_i < components.count and components[component_i].position.y == row_y)
                local component = components[component_i]
                row_w += component.size.x
                row.add( component )
                ++component_i
              endWhile

              # Align the row.
              local delta = XY( (content_size.x - row_w) * content_alignment.position.x, 0 )
              if (snap) delta .= floor
              forEach (component in row)
                component.position += delta
              endForEach
            endWhile
          endUse
        endIf

      endUse

      prior.on_end_layout

    method perform_content_layout [override]
      if (layout_finished) return

      use components = display_components
        localize content_position
        layout_cursor    = content_position
        max_width        = 0
        cur_line_height  = 0
        cur_line_advance = 0

        local available_width = content_size.x

        # Perform layout with top-left origin.
        local i = 0
        while (i < components.count)
          local component = components[i]
          cur_line_height  .= or_larger( component.size.y )
          cur_line_advance .= or_larger( component.line_height )

          local w = component.size.x
          local too_wide = (layout_cursor.x + w > available_width)
          contingent
            if (component.is_br)
              ++i
              sufficient
            endIf
            if (too_wide)
              if local split_position = component.find_h_split( available_width - layout_cursor.x )
                component.split_h( split_position, components, i )
                nextIteration
              endIf
              sufficient (layout_cursor.x > content_position.x)
            endIf
            escapeContingent
          satisfied
            layout_cursor.x = content_position.x
            layout_cursor.y += cur_line_advance
            cur_line_height  = 0
            cur_line_advance = 0
            nextIteration
          endContingent

          ++i
          component.perform_layout( layout_cursor )
          if (layout_cursor.x or not component.is_space)
            layout_cursor.x += w
            max_width .= or_larger( layout_cursor.x )
          endIf
        endWhile

        # Leave cursor as min size to enclose content
        layout_cursor.x = max_width
        layout_cursor.y += cur_line_height

        layout_finished = true
      endUse

    method resolve_content_layout_sizes( available_size:XY ) [override]
      if (layout_finished) return
      use components = WorkList<<Component>>
        collect_child_display_components( components )
        (forEach in components).resolve_layout_size( available_size )
      endUse

    method set_content( text:String )
      set_content( Text(text) )

endClass
