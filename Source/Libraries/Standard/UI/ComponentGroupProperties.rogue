library UI

class ComponentGroupProperties [aspect]
  # Example usage: extend Component[] and incorporate this aspect; because Component[]
  # implements collection iteration protocols (iterator() etc.), calling e.g.
  # align_content_left() will call align_content_left() on all elements of the list.
  METHODS
    method align_content( content_alignment:Anchor )
      (forEach in this).align_content( content_alignment )

    method align_content_top_left
      (forEach in this).align_content_top_left

    method align_content_top
      (forEach in this).align_content_top

    method align_content_top_right
