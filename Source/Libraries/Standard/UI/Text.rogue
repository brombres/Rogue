library UI

class Text : Component
  # Note: for custom classes that extend Text, you may wish to override can_split().
  PROPERTIES
    value         : String
    scaling_mode  = ScalingModeXY( ScalingMode.NONE, ScalingMode.NONE )
    sizing_mode   = SizingModeXY( SizingMode.NATURAL, SizingMode.NATURAL )
    can_split : Logical?

  METHODS
    method init( text=String():String, &fragment )
      .process_and_store( text, &=fragment )

    method .add_builder( builder:String )
      if (builder.count)
        if (builder.last == ' ')
          # Make a trailing space its own element
          builder.remove_last
          add( create_fragment(builder.cloned,&fragment) )
          add( create_fragment(" ",&fragment) )
        else
          add( create_fragment(builder.cloned,&fragment) )
        endIf
        builder.clear
      endIf

    method aspect_fit_text
      aspect_fit_text_to_width
      aspect_fit_text_to_height

    method aspect_fit_text_to_height
      scaling_mode.y = ScalingMode.ASPECT_FIT

    method aspect_fit_text_to_width
      scaling_mode.x = ScalingMode.ASPECT_FIT

    method can_split->Logical
      # If true, Text can be internally split for word-wrapping purposes.
      # By default only true for base type Text.
      if (@can_split) return @can_split.value
      return this isType Text

    method create_fragment( text=String():String, &fragment )->Text [novel]
      return Text( text, &=fragment )

    method description->String
      local result = ''$($)''(type_name,value?.to_escaped_ascii||"")
      if (count)
        result.print '['
        forEach (child at i in children)
          if (i > 0) result.print ','
          result.print child
        endForEach
        result.print ']'
      endIf
      return result

    method display_position->XY
      if (is_display_component) return prior.display_position
      else                      return parent->(as Component)?.display_position

    method find_h_split( max_width:Real, &force )->Real? [override]
      local font = font
      assert font

      forEach (ch at i in value step -1)
        if (ch == ' ' or ch == '\n' or ch == '\r' or ch == '\t')
          if (i == 0) escapeForEach
          local w = font.measure( value, 0, i ).x
          if (w < max_width) return i
        endIf
      endForEach

      if (force)
        # No good space to break the text, so break mid-word. Can still return
        # null if not even the first letter will fit.
        forEach (ch at i in value step -1)
          if (i == 0) escapeForEach
          local w = font.measure( value, 0, i ).x
          if (w < max_width) return i
        endForEach
      endIf

      return null

    method font->Font
      if (text_style and text_style.font)
        return text_style.font.value
      else
        return prior.font
      endIf

    method is_br->Logical [override]
      return value == "\n"

    method is_space->Logical [override]
      return value == " "

    method is_display_component->Logical [override]
      return count == 0

    method line_height->Real
      if local font = font
        return font.height * font.line_spacing
      else
        return 0.0
      endIf

    method minimum_layout_size( available_size:XY, &limited )->XY [override]
      if local font = font
        return font.measure( value )
      else
        return XY.zero
      endIf

    method on_begin_layout [override]
      .update_size
      prior.on_begin_layout

    method .update_size
      local font = font

      local measured_size = font?.measure( value || "" )

      @natural_size = measured_size

      if (sizing_mode.x == SizingMode.NATURAL)
        if (sizing_mode.y == SizingMode.NATURAL)
          size = natural_size
        else
          size.x = natural_size.x
        endIf
      elseIf (sizing_mode.y == SizingMode.NATURAL)
        size.y = natural_size.y
      endIf

    method on_draw [override]
      if local font = font
        font.draw( this )
      else
        println "ERROR: UI.default_font is undefined."
      endIf

    method set_value( new_value:String )
      if (not new_value) new_value = ""
      if (new_value != value)
        if (not value) @value = String()
        value.clear
        value.print( new_value )
        local old_natural_size = natural_size
        .process_and_store( value )
        if (natural_size != old_natural_size)
          contingent
            sufficient (sizing_mode.x == SizingMode.NATURAL)
            sufficient (sizing_mode.y == SizingMode.NATURAL)
            sufficient (sizing_mode.x == SizingMode.SHRINK_TO_FIT)
            sufficient (sizing_mode.y == SizingMode.SHRINK_TO_FIT)
            escapeContingent
          satisfied
            request_layout
          endContingent
        endIf
      endIf

    method set_value( new_value:Real, decimal_digits=4:Int )
      use buffer = StringPool
        buffer.print( new_value, decimal_digits )
        set_value( buffer )
      endUse

    method set_value( new_value:Int )
      use buffer = StringPool
        buffer.print( new_value )
        set_value( buffer )
      endUse

    method shrink_text_to_fit_size
      shrink_text_to_fit_width
      shrink_text_to_fit_height

    method shrink_text_to_fit_height
      scaling_mode.y = ScalingMode.SHRINK_TO_FIT

    method shrink_text_to_fit_width
      scaling_mode.x = ScalingMode.SHRINK_TO_FIT

    method split_h( split_position:Real, components:Component[], component_i:Int ) [override]
      local left, center, right : Text

      local split_i = split_position->Int
      if (split_i) left = create_fragment( value.substring(0, split_i), &fragment )
      center = create_fragment( value[split_i], &fragment )
      if (split_i + 1 < value.count) right = create_fragment( value.substring(split_i+1), &fragment )

      if (left) add( left )
      add( center )
      if (right) add( right )

      components.remove_at( component_i )
      if (right) components.insert( right, component_i )
      components.insert( center, component_i )
      if (left) components.insert( left, component_i )

      # Have the new child components set their size
      left?.begin_layout
      center.begin_layout
      right?.begin_layout

    method to->String
      return description

    method use_unscaled_text
      use_unscaled_text_width
      use_unscaled_text_height

    method use_unscaled_text_height
      scaling_mode.y = ScalingMode.NONE

    method use_unscaled_text_width
      scaling_mode.x = ScalingMode.NONE
      sizing_mode.x = SizingMode.FIXED

    method .process_and_store( text:String, &fragment )
      block
        clear

        if (not text)
          if (not value) @value = String()
          escapeBlock
        endIf

        if (not can_split)
          if (value)
            if (value is not text)
              value.clear
              value.print( text )
            endIf
          else
            @value = text.cloned
          endIf
          escapeBlock
        endIf

        if (fragment and text.count <= 1)
          @value = text
          escapeBlock
        endIf

        use processed = StringPool
          processed.reserve( text.count )

          local iterator = text.iterator
          local prev = -1
          local has_eol = false
          local is_modified = false
          loop
            if local ch = iterator.read_another
              if (ch == '\r')     is_modified = true; nextIteration
              if (ch == '\n')     has_eol = true
              elseIf (ch == '\t') ch = ' '; is_modified = true
              if (ch == ' ')
                if (prev == ' ') is_modified = true; nextIteration
              endIf
              processed.print( ch )
              prev = ch
            else
              escapeLoop
            endIf
          endLoop

          local has_edge_spaces = processed[0] == ' ' or processed.last == ' '
          if (has_eol or has_edge_spaces) is_modified = true

          if (not is_modified)
            if (value is not text)
              if (fragment) @value = text
              else          @value = processed.cloned
            endIf
            escapeBlock
          endIf

          use builder = StringPool
            forEach (ch in processed)
              if (ch == '\n')
                .add_builder( builder )
                add( create_fragment('\n',&fragment) )
              elseIf (ch == ' ' and not builder.count)
                # Leading space becomes its own element
                add( create_fragment(' ',&fragment) )
              else
                builder.print ch
              endIf
            endForEach
            .add_builder( builder )
          endUse

        endUse
      endBlock

      .update_size

endClass
