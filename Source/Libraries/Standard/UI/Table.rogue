library UI

class Table : Component
  PROPERTIES
    gap              : Real  # In pixels
    gap_parameter_id : VariantEntryID
    width            : Int  # cells wide
    height           : Int  # cells high

    .cells           = TableCell[]
    # A list of the direct children; width*height TableCell components which
    # contain the actual content.

    sizes_resolved_for : XY?

  METHODS
    method init( width:Int, height:Int )
      resize( width, height )

    method init_object
      is_pointer_passthrough = true

    method add( entity:Entity ) [override]
      # Adds the entity to the first empty cell. If there are
      # no empty cells, starts a new row.
      forEach (cell in .cells)
        if (cell.count == 0 and not cell.is_obscured)
          cell.add( entity )
          return
        endIf
      endForEach

      resize( width, height+1 )
      update_cell_visibility

      this[XY(0,height-1)] = entity->(as Component)

    method add_column( components:Component[] )
      resize( width+1, height )
      components.discard_from( height )
      local i = width - 1
      forEach (component at j in components)
        this[XY(i,j)] = component
      endForEach

    method add_row( components:Component[] )
      resize( width, height+1 )
      components.discard_from( width )
      local j = height - 1
      forEach (component at i in components)
        this[XY(i,j)] = component
      endForEach

    method cell( i:Int, j:Int )->TableCell
      if (i < 0 or i >= width)  return null
      if (j < 0 or j >= height) return null
      return .cells[j*width + i]

    method cell( index:XY )->TableCell
      return cell( index.x->Int, index.y->Int )

    method cells->TableSubset
      return TableSubset( this, 0, 0, width-1, height-1 )

    method column( index:Int )->TableSubset
      return TableSubset( this, index, 0, index, height-1 )

    method column_minmax_width( i:Int, available_size:XY )->(min:Real,max:Real)
      local column_min_w = 0.0
      local column_max_w = available_size.x
      forEach (j in 0..<height)
        if local cell = cell( i, j )
          local content : Component
          if (cell.sizing_mode.x == SizingMode.MANAGED) content = cell.first_content_component
          else                                          content = cell
          if (content)
            local (min_sz,max_sz) = content.resolve_minmax_layout_size( available_size.yv, available_size, &limited )
            column_min_w .= or_larger( min_sz.x )
            column_max_w .= or_smaller( max_sz.x )
          endIf
        endIf
      endForEach
      if (column_min_w > column_max_w) column_max_w = column_min_w
      return (min:column_min_w,max:column_max_w)

    method columns->TableSubset
      return TableSubset( this, 0, 0, width-1, height-1 )

    method columns( range:RangeUpTo<<Int>> )->TableSubset
      if (range.step != 1) println "[ERROR] Table.columns() range step size must be 1"
      return TableSubset( this, range.start, 0, range.limit, height-1 )

    method get( index:XY )->Component
      local cell = cell( index )
      if (cell) return cell.first_content_component
      else      return null

    method minimum_layout_size( available_size:XY, &limited )->XY [override]
      local sz = gap * XY(width-1,height-1)
      resolve_content_layout_sizes( sz )
      forEach (i in 0..<width)  sz.x += .cells[i].size.x
      forEach (j in 0..<height) sz.y += .cells[j*width].size.y
      return sz

    method .minimum_row_layout_size( j:Int, available_size:XY, &limited )->XY
      local snap = UI.snap_to_pixel_coordinates

      local w = 0.0
      local h = 0.0
      forEach (i in 0..<width)
        local cell = cell( XY(i,j) )
        local sz = cell.minimum_layout_size( available_size, &=limited )
        sz /= cell.span
        if (snap) sz .= ceiling

        if (i) w += gap
        w += sz.x
        h .= or_larger( sz.y )
      endForEach
      return XY(w,h)

    method perform_content_layout [override]
      localize gap

      use components = display_components
        local total_w = 0.0
        local total_h = 0.0

        forEach (i in 0..<width)
          local cell = .cells[i]
          if (not cell.is_obscured)
            if (i) total_w += gap
            total_w += cell.size.x
          endIf
        endForEach

        forEach (j in 0..<height)
          local cell = .cells[j*width]
          if (not cell.is_obscured)
            if (j) total_h += gap
            total_h += cell.size.y
          endIf
        endForEach

        local pos = Box(XY(total_w,total_h)).positioned_within( content_bounds, anchor ).position
        local start_x = pos.x
        local index = 0
        forEach (j in 0..<height)
          local row_h = 0.0
          forEach (i in 0..<width)
            local cell = .cells[index]
            if (i == 0) row_h = cell.size.y
            if (cell.is_obscured)
              cell.hide
            else
              cell.show
              cell.perform_layout( pos )
              pos.x += cell.size.x + gap
            endIf
            ++index
          endForEach
          pos.x = start_x
          pos.y += row_h + gap
        endForEach

      endUse

    method resize( w:Int, h:Int )
      if (count)
        use new_cells = WorkList<<TableCell>>
          forEach (j in 0..<height.or_smaller(h))
            forEach (i in 0..<width.or_smaller(w))
              new_cells.add( .cells[j*width+i] )
            endForEach
            if (w > width)
              local last_i = width - 1
              forEach (i in width..<w)
                local new_cell = TableCell( XY(i,j) )
                new_cell.copy_settings_from( cell(last_i,j) )
                new_cells.add( new_cell )
              endForEach
            endIf
          endForEach

          if (h > height)
            local last_j = height - 1
            forEach (j in height..<h)
              forEach (i in 0..<w)
                local new_cell = TableCell( XY(i,j) )
                new_cell.copy_settings_from( cell(i,last_j) )
                new_cells.add( new_cell )
              endForEach
            endForEach
          endIf

          .cells.clear
          .cells.add( forEach in new_cells )

          prior.clear
          prior.add( forEach in .cells )
        endUse
      else
        forEach (j in 0..<h)
          forEach (i in 0..<w)
            .cells.add( TableCell(XY(i,j)) )
          endForEach
        endForEach
        prior.add( forEach in .cells )
      endIf

      @width = w
      @height = h

    method resolve_content_layout_sizes( available_size:XY ) [override]
      if (sizes_resolved_for == available_size) return
      sizes_resolved_for = available_size

      if (width > 1)  available_size.x = (available_size.x - (width-1) * gap).clamped_low( 0 )
      if (height > 1) available_size.y = (available_size.y - (height-1) * gap).clamped_low( 0 )

      local snap = UI.snap_to_pixel_coordinates

      use column_info_list = WorkList<<ColumnSizeInfo>>,
          row_info_list = WorkList<<RowSizeInfo>>
        # Collect largest min & smallest max sizes of columns and rows
        local largest_cell_min_w = 0.0
        local smallest_cell_max_w = available_size.x
        forEach (i in 0..<width)
          local (min_w,max_w) = column_minmax_width( i, available_size )
          largest_cell_min_w .= or_larger( min_w )
          smallest_cell_max_w .= or_smaller( max_w )
          column_info_list.add( ColumnSizeInfo(i, min_w, max_w, .column_weight(i)) )
        endForEach
        smallest_cell_max_w .= or_larger( largest_cell_min_w )

        local largest_cell_min_h = 0.0
        local smallest_cell_max_h = available_size.y
        forEach (j in 0..<height)
          local (min_h,max_h) = row_minmax_height( j, available_size )
          largest_cell_min_h .= or_larger( min_h )
          smallest_cell_max_h .= or_smaller( max_h )
          row_info_list.add( RowSizeInfo(j, min_h, max_h, .row_weight(j)) )
        endForEach
        smallest_cell_max_h .= or_larger( largest_cell_min_h )

        # Assign widths to non-managed columns with a max width too narrow or a min width too wide
        # for their proportional share.
        block
          local total_column_weight = 0.0
          total_column_weight += (forEach in column_info_list).weight

          local repeat = true
          while (repeat)
            repeat = false

            local remaining_width = available_size.x
            local remaining_count = column_info_list.count

            forEach (info in rewriter=column_info_list.rewriter)
              local cell = this.cell( info.i, 0 )
              if (cell.sizing_mode.x == SizingMode.MANAGED)
                rewriter.write( info )
              else
                local w = remaining_width
                if (remaining_count > 1)
                  w = w * info.weight / total_column_weight
                  if (snap) w .= floor
                endIf
                if (info.max_width < w)
                  # Column's max width falls short of its share. Assign it its max width and
                  # remove it from the list by not rewriting it.
                  available_size.x -= info.max_width
                  .set_column_width( info.i, info.max_width )
                  total_column_weight -= info.weight
                  if (total_column_weight == 0) total_column_weight = 1.0
                  repeat = true
                elseIf (info.min_width > w)
                  # Component's min width exceeds its share. Assign it its min width
                  # and remove it from the list by not rewriting it.
                  available_size.x -= info.min_width
                  .set_column_width( info.i, info.min_width )
                  total_column_weight -= info.weight
                  if (total_column_weight == 0) total_column_weight = 1.0
                  repeat = true
                else
                  # Component can size at least as wide as its proportional share; keep it for the next pass.
                  rewriter.write( info )
                endIf
                remaining_width -= w
                --remaining_count
              endIf
            endForEach
          endWhile
        endBlock

        # If the table is shrink-to-fit-width, assign remaining managed columns the largest min cell width.
        if (sizing_mode.x == SizingMode.SHRINK_TO_FIT)
          forEach (info in rewriter=column_info_list.rewriter)
            local cell = this.cell( info.i, 0 )
            if (cell.sizing_mode.x == SizingMode.MANAGED)
              local w = (largest_cell_min_w * cell.weight.x).floor
              available_size.x -= w
              .set_column_width( info.i, w )
            else
              rewriter.write( info )
            endIf
          endForEach
        endIf

        # Assign remaining columns their proportional share of available width.
        block
          local total_column_weight = 0.0
          total_column_weight += (forEach in column_info_list).weight

          # Weighted columns
          local remaining_width = available_size.x
          local remaining_count = column_info_list.count( $.weight > 0 )
          forEach (info in column_info_list)
            if (info.weight)
              local w = remaining_width
              if (remaining_count > 1)
                w = w * info.weight / total_column_weight
                total_column_weight -= info.weight
                if (snap) w .= floor
              endIf
              .set_column_width( info.i, w )
              remaining_width -= w
              --remaining_count
            else
              # Set zero-weight column width to 0 for now
              .set_column_width( info.i, 0 )
            endIf
          endForEach

          if (remaining_width)
            # Unweighted columns
            remaining_count = column_info_list.count( $.weight == 0 )
            forEach (info in column_info_list)
              if (info.weight == 0)
                local w = remaining_width
                if (remaining_count > 1)
                  w /= remaining_count
                  if (snap) w .= floor
                endIf
                .set_column_width( info.i, w )
                remaining_width -= w
                --remaining_count
              endIf
            endForEach
          endIf

        endBlock

        # Assign row heights for components that are too high or too short
        block
          local total_row_weight = 0.0
          total_row_weight += (forEach in column_info_list).weight

          local repeat = true
          while (repeat)
            repeat = false

            local remaining_height = available_size.y
            local remaining_count = row_info_list.count

            forEach (info in rewriter=row_info_list.rewriter)
              local cell = this.cell( 0, info.j )
              if (cell.sizing_mode.y == SizingMode.MANAGED)
                rewriter.write( info )
              else
                local h = remaining_height
                if (remaining_count > 1)
                  h = h * info.weight / total_row_weight
                  if (snap) h .= floor
                endIf
                if (info.max_height < h)
                  # Column's max height falls short of its share. Assign it its max height and
                  # remove it from the list by not rewriting it.
                  available_size.y -= info.max_height
                  .set_row_height( info.j, info.max_height )
                  total_row_weight -= info.weight
                  if (total_row_weight == 0) total_row_weight = 1.0
                  repeat = true
                elseIf (info.min_height > h)
                  # Component's min height exceeds its share. Assign it its min height
                  # and remove it from the list by not rewriting it.
                  available_size.y -= info.min_height
                  .set_row_height( info.j, info.min_height )
                  total_row_weight -= info.weight
                  if (total_row_weight == 0) total_row_weight = 1.0
                  repeat = true
                else
                  # Component can size at least as high as its proportional share; keep it for the next pass.
                  rewriter.write( info )
                endIf
                remaining_height -= h
                --remaining_count
              endIf
            endForEach
          endWhile
        endBlock

        # If the table is shrink-to-fit-height, assign remaining managed rows the largest min cell height.
        if (sizing_mode.y == SizingMode.SHRINK_TO_FIT)
          forEach (info in rewriter=row_info_list.rewriter)
            local cell = this.cell( 0, info.j )
            if (cell.sizing_mode.y == SizingMode.MANAGED)
              local h = (largest_cell_min_h * cell.weight.y).floor
              available_size.y -= h
              .set_row_height( info.j, h )
            else
              rewriter.write( info )
            endIf
          endForEach
        endIf

        # Assign remaining rows their proportional share of available height.
        block
          # Weighted columns
          local total_row_weight = 0.0
          total_row_weight += (forEach in column_info_list).weight

          local remaining_height = available_size.y
          local remaining_count = row_info_list.count
          forEach (info in row_info_list)
            if (info.weight)
              local h = remaining_height
              if (remaining_count > 1)
                h = h * info.weight / total_row_weight
                total_row_weight -= info.weight
                if (snap) h .= floor
              endIf
              .set_row_height( info.j, h )
              remaining_height -= h
              --remaining_count
            else
              # Set zero-weight row height to 0 for now
              .set_row_height( info.j, 0 )
            endIf
          endForEach

          if (remaining_height)
            # Unweighted columns
            remaining_count = row_info_list.count( $.weight == 0 )
            forEach (info in row_info_list)
              if (info.weight == 0)
                local h = remaining_height
                if (remaining_count > 1)
                  h /= remaining_count
                  if (snap) h .= floor
                endIf
                .set_row_height( info.j, h )
                remaining_height -= h
                --remaining_count
              endIf
            endForEach
          endIf

        endBlock

        # All child cells have their own size set or assigned; have them recursively
        # determine their child sizes.
        forEach (cell in .cells)
          cell.resolve_layout_size( .spanned_size(cell) )
          cell.resolve_content_layout_sizes
        endForEach

      endUse

    method .spanned_size( cell:TableCell )->XY
      if (cell.span == XY(1,1)) return cell.size
      local sz = (cell.span-XY(1,1)) * gap
      forEach (j in 0..<cell.span.y)
        forEach (i in 0..<cell.span.x)
          if local part = this.cell( cell.index+XY(i,j) )
            sz += part.size
          endIf
        endForEach
      endForEach
      return sz

    method .column_weight( i:Int )->Real
      local result = 0.0
      result += cell( XY(i,forEach in 0..<height) ).weight.x
      return result

    method .row_weight( j:Int )->Real
      local result = 0.0
      result += cell( XY(forEach in 0..<width,j) ).weight.y
      return result

    method row( index:Int )->TableSubset
      return TableSubset( this, 0, index, width-1, index )

    method row_minmax_height( j:Int, available_size:XY )->(min:Real,max:Real)
      local row_min_h = 0.0
      local row_max_h = available_size.y
      forEach (i in 0..<width)
        if local cell = cell( i, j )
          local content : Component
          if (cell.sizing_mode.y == SizingMode.MANAGED) content = cell.first_content_component
          else                                          content = cell
          if (content)
            local (min_sz,max_sz) = content.resolve_minmax_layout_size( available_size.xv, available_size, &limited )
            row_min_h .= or_larger( min_sz.y )
            row_max_h .= or_smaller( max_sz.y )
          endIf
        endIf
      endForEach
      if (row_min_h > row_max_h) row_max_h = row_min_h
      return (min:row_min_h,max:row_max_h)

    method rows->TableSubset
      return TableSubset( this, 0, 0, width-1, height-1 )

    method rows( range:RangeUpTo<<Int>> )->TableSubset
      if (range.step != 1) println "[ERROR] Table.rows() range step size must be 1"
      return TableSubset( this, 0, range.start, width-1, range.limit )

    method .set_column_width( i:Int, w:Real )
      forEach (j in 0..<height)
        local index = j*width + i
        local cell = .cells[index]
        cell.size.x = w
        if (cell.sizing_mode.x == SizingMode.MANAGED) cell.layout_size.x = w
      endForEach

    method .set_row_height( j:Int, h:Real )
      forEach (i in 0..<width)
        local index = j*width + i
        local cell = .cells[index]
        cell.size.y = h
        if (cell.sizing_mode.y == SizingMode.MANAGED) cell.layout_size.y = h
      endForEach

    method on_begin_layout
      prior.on_begin_layout
      if (gap_parameter_id)
        @gap = gap_parameter_id->Real
      endIf
      sizes_resolved_for = null

    method set( index:XY, component:Component )
      local cell = cell( index )
      if (cell)
        cell.clear
        cell.add( component )
      endIf

    method set_cell( index:XY, cell:TableCell )
      local i = index.x->Int
      local j = index.y->Int
      if (i < 0 or i >= width)  return
      if (j < 0 or j >= height) return
      .cells[j*width + i] = cell

    method set_gap( @gap ) [override]
      @gap_parameter_id = VariantEntryID(0)

    method set_gap( gap_parameter_id )
      @gap = gap_parameter_id->Real

    method update_cell_visibility
      # Update cell visibility settings based on current cell span values
      (forEach in .cells).is_obscured = false

      local index = 0
      forEach (j in 0..<height)
        forEach (i in 0..<width)
          local cell = .cells[index]
          if (cell.span.product > 1)
            forEach (dj in 0..<cell.span.y)
              forEach (di in 0..<cell.span.x)
                if (di or dj)
                  local obscured_cell = this.cell( XY(i+di,j+dj) )
                  obscured_cell.is_obscured = true
                endIf
              endForEach
            endForEach
          endIf
          ++index
        endForEach
      endForEach

endClass

class TableCell( index:XY ) : Component
  PROPERTIES
    span        = XY( 1, 1 )
    is_obscured : Logical  # layout helper

  METHODS
    method init_object
      is_pointer_passthrough = true
      managed_size

    method set_span( @span )
      if local table = parent->(as Table)
        table.update_cell_visibility
      endIf

    method to->String
      return "TableCell$"(index)

endClass

class ColumnSizeInfo( i:Int, min_width:Real, max_width:Real, weight:Real ) [compound]
endClass

class RowSizeInfo( j:Int, min_height:Real, max_height:Real, weight:Real ) [compound]
endClass

class TableSubset( table:Table, i1:Int, j1:Int, i2:Int, j2:Int ) : ComponentGroupProperties [compound]
  METHODS
    method iterator->TableSubsetIterator
      return TableSubsetIterator( table, i1, j1, i2, j2, i1 )
endClass

class TableSubsetIterator( table:Table, i:Int, j:Int, i2:Int, j2:Int, i1:Int ) [compound]
  METHODS
    method read_another->TableCell? [mutating]
      if (i <= i2 and j <= j2)
        local result = table.cell( XY(i, j) )
        ++i
        if (i > i2)
          i = i1
          ++j
        endIf
        return result
      else
        return null
      endIf
endClass
