library UI

class Table : Component
  PROPERTIES
    gap                : XY  # In pixels
    h_gap_parameter_id : VariantEntryID
    v_gap_parameter_id : VariantEntryID

    cells_wide         : Int
    cells_high         : Int

    columns            = TableColumns()
    rows               = TableRows()

    .cells             = TableCell[]
    # A list of the direct children; cells_wide*cells_high TableCell components which
    # contain the actual content.

    size_resolved_for : XY?

  METHODS
    method init( cells_wide:Int, cells_high:Int )
      resize( cells_wide, cells_high )
      align_content_center

    method init_object
      is_pointer_passthrough = true

    method add( entity:Entity ) [override]
      # Adds the entity to the first empty cell. If there are
      # no empty cells, starts a new row.
      forEach (cell in .cells)
        if (cell.count == 0 and not cell.is_obscured)
          cell.add( entity )
          return
        endIf
      endForEach

      resize( cells_wide, cells_high+1 )
      update_cell_visibility

      this[XY(0,cells_high-1)] = entity->(as Component)

    method cell( i:Int, j:Int )->TableCell
      if (i < 0 or i >= cells_wide)  return null
      if (j < 0 or j >= cells_high) return null
      return .cells[j*cells_wide + i]

    method cells->TableSubsetProperties
      return TableSubsetProperties( this, 0, 0, cells_wide-1, cells_high-1 )

    method cells( i1:Int, j1:Int, i2:Int, j2:Int )->TableSubsetProperties
      return TableSubsetProperties( this, i1, j1, i2, j2 )

    method column( i:Int )->TableColumn
      if (i < 0 or i >= cells_wide) return null
      return columns[i]

    method .determine_column_minmax_width( column:TableColumn, available_size:XY )
      local snap = UI.snap_to_pixel_coordinates

      local column_min_w = 0.0
      local column_max_w = available_size.x

      forEach (j in 0..<cells_high)
        if local cell = cell( column.i, j )
          if local content = cell.first_content_component
            local (min_sz,max_sz) = content.resolve_minmax_layout_size( available_size.yv, available_size, &limited )
            if (cell.span.x > 1)
              min_sz.x /= cell.span.x
              max_sz.x /= cell.span.x
              if (snap) min_sz.x .= ceiling; max_sz.x .= ceiling
            endIf
            column_min_w .= or_larger( min_sz.x )
            column_max_w .= or_smaller( max_sz.x )
          endIf
        endIf
      endForEach

      if (column_min_w > column_max_w) column_max_w = column_min_w
      column.min_width = column_min_w
      column.max_width = column_max_w

    method get( i:Int, j:Int )->Component
      local cell = cell( i, j )
      if (cell) return cell.first_content_component
      else      return null

    method minimum_layout_size( available_size:XY, &limited )->XY [override]
      local sz = gap * XY(cells_wide-1,cells_high-1)
      temporarily sizing_mode = SizingModeXY( SizingMode.SHRINK_TO_FIT )
        resolve_content_layout_sizes( sz )
      endTemporarily
      size_resolved_for = null

      forEach (i in 0..<cells_wide)  sz.x += .cells[i].size.x
      forEach (j in 0..<cells_high) sz.y += .cells[j*cells_wide].size.y
      return sz

    method perform_content_layout [override]
      localize gap

      use components = display_components
        local total_w = 0.0
        local total_h = 0.0

        forEach (i in 0..<cells_wide)
          local cell = .cells[i]
          if (not cell.is_obscured)
            if (i) total_w += gap.x
            total_w += cell.size.x
          endIf
        endForEach

        forEach (j in 0..<cells_high)
          local cell = .cells[j*cells_wide]
          if (not cell.is_obscured)
            if (j) total_h += gap.y
            total_h += cell.size.y
          endIf
        endForEach

        local pos = snapped( Box(XY(total_w,total_h)).positioned_within( content_bounds, anchor ).position )
        local start_x = pos.x
        local index = 0
        forEach (j in 0..<cells_high)
          local row_h = 0.0
          forEach (i in 0..<cells_wide)
            local cell = .cells[index]
            if (i == 0) row_h = cell.size.y
            if (cell.is_obscured)
              cell.hide
            else
              cell.show
              cell.perform_layout( pos )
              pos.x += cell.size.x + gap.x
            endIf
            ++index
          endForEach
          pos.x = start_x
          pos.y += row_h + gap.y
        endForEach

      endUse

    method resize( w:Int, h:Int )
      if (count)
        use new_cells = WorkList<<TableCell>>
          forEach (j in 0..<cells_high.or_smaller(h))
            forEach (i in 0..<cells_wide.or_smaller(w))
              new_cells.add( .cells[j*cells_wide+i] )
            endForEach

            if (w > cells_wide)
              local last_i = cells_wide - 1
              forEach (i in cells_wide..<w)
                columns.add( TableColumn(this,i) )
                local new_cell = TableCell( XY(i,j) )
                new_cell.copy_settings_from( cell(last_i,j) )
                new_cells.add( new_cell )
              endForEach
            endIf
          endForEach

          if (h > cells_high)
            local last_j = cells_high - 1
            forEach (j in cells_high..<h)
              rows.add( TableRow(this,j) )
              forEach (i in 0..<w)
                local new_cell = TableCell( XY(i,j) )
                new_cell.copy_settings_from( cell(i,last_j) )
                new_cells.add( new_cell )
              endForEach
            endForEach
          endIf

          .cells.clear
          .cells.add( forEach in new_cells )

          deactivate
          prior.clear
          prior.add( forEach in .cells )
        endUse
      else
        forEach (i in 0..<w) columns.add( TableColumn(this,i) )
        forEach (j in 0..<h) rows.add( TableRow(this,j) )

        forEach (j in 0..<h)
          forEach (i in 0..<w)
            .cells.add( TableCell(XY(i,j)) )
          endForEach
        endForEach
        prior.add( forEach in .cells )

      endIf

      cells_wide = w
      cells_high = h

    method resolve_layout_size( available_size:XY, &limited )->XY [override]
      if (sizing_mode.x == SizingMode.NATURAL or sizing_mode.y == SizingMode.NATURAL)
        resolve_content_layout_sizes( available_size )  # sets natural_size
      endIf
      return prior.resolve_layout_size( available_size, &=limited )

    method resolve_content_layout_sizes( available_size:XY ) [override]
      if (size_resolved_for == available_size) return
      size_resolved_for = available_size

      available_size -= (XY(cells_wide-1,cells_high-1) * gap).clamped_low( XY(0,0) )

      use unresolved_columns = WorkList<<TableColumn>>,
          unresolved_rows = WorkList<<TableRow>>

        # Apply widths of fixed-width columns and collect variable width columns for
        # further processing.
        forEach (column in columns)
          if (column.sizing_mode == SizingMode.FIXED_PIXELS)
            column.is_resolved = true
            column.width = column.layout_width
            available_size.x -= column.width
          elseIf (column.sizing_mode == SizingMode.FIXED_POINTS)
            column.is_resolved = true
            column.width = column.layout_width * UI.display_density
            available_size.x -= column.width
          else
            column.is_resolved = false
            unresolved_columns.add( column )
          endIf
        endForEach

        if (unresolved_columns.count)
          # Collect largest min & smallest max sizes of unresolved columns and rows
          forEach (column in unresolved_columns)
            .determine_column_minmax_width( column, available_size )
          endForEach

          .resolve_column_widths( unresolved_columns, available_size )
        endIf

        # Apply heights of fixed-height rows and collect variable-height rows for
        # further processing.
        forEach (row in rows)
          if (row.sizing_mode == SizingMode.FIXED_PIXELS)
            row.is_resolved = true
            row.height = row.layout_height
            available_size.y -= row.height
          elseIf (row.sizing_mode == SizingMode.FIXED_POINTS)
            row.is_resolved = true
            row.height = row.layout_height * UI.display_density
            available_size.y -= row.height
          else
            row.is_resolved = false
            unresolved_rows.add( row )
          endIf
        endForEach

        if (unresolved_rows.count)
          # Collect largest min & smallest max sizes of unresolved columns and rows
          forEach (row in unresolved_rows)
            .determine_row_minmax_height( row, available_size )
          endForEach

          .resolve_row_heights( unresolved_rows, available_size )
        endIf

        .resolve_cell_layout_sizes

        if (this.sizing_mode.x == SizingMode.NATURAL)
          natural_size.x = gap.x * (cells_wide-1)
          natural_size.x += (forEach in columns).width
        endIf

        if (this.sizing_mode.y == SizingMode.NATURAL)
          natural_size.y = gap.y * (cells_high-1)
          natural_size.y += (forEach in rows).height
        endIf

      endUse

    method .resolve_column_widths( unresolved_columns:TableColumn[], available_size:XY )
      local remaining_size = available_size

      # Resolve shrink-to-fit columns by assigning them their min size
      local snap = UI.snap_to_pixel_coordinates
      forEach (column in writer=unresolved_columns.rewriter)
        if (column.sizing_mode == SizingMode.SHRINK_TO_FIT)
          column.width = (column.min_width * column.weight)
          if (snap) column.width .= floor
          remaining_size.x -= column.width
        else
          writer.write( column )
        endIf
      endForEach

      if (unresolved_columns.is_empty) return

      # Resolve proportional column widths relative to the total available width
      forEach (column in writer=unresolved_columns.rewriter)
        if (column.sizing_mode == SizingMode.PROPORTIONAL)
          column.width = (column.layout_width * available_size.x)
          if (snap) column.width .= floor
          remaining_size.x -= column.width
        else
          writer.write( column )
        endIf
      endForEach

      if (unresolved_columns.is_empty) return

      # Each remaining unresolved column is expand-to-fill.

      if (this.sizing_mode.x == SizingMode.NATURAL)
        # Natural column width is the min width of the widest column
        local natural_width = 0.0
        natural_width .= or_larger( (forEach in unresolved_columns).min_width )

        local necessary_width = 0.0
        forEach (column in unresolved_columns)
          necessary_width += (natural_width * column.weight).floor
        endForEach

        remaining_size.x .= or_smaller( necessary_width )
      endIf

      # Resolve column widths of columns with min-width too wide for proportional share.
      block
        local repeat = true
        while (repeat)
          repeat = false

          local total_width = remaining_size.x
          local total_weight = 0.0
          total_weight += (forEach in unresolved_columns).weight

          forEach (column in writer=unresolved_columns.rewriter)
            if (column.weight)
              local w = total_width * column.weight / total_weight
              if (snap) w .= floor

              if (column.min_width > w)
                # Component's min width exceeds its share. Assign it its min width
                # and remove it from the list by not rewriting it.
                remaining_size.x -= column.min_width
                column.width = column.min_width
                repeat = true
              else
                writer.write( column )
              endIf
            else
              writer.write( column )
            endIf
          endForEach
        endWhile
      endBlock

      # Resolve column widths of remaining weighted columns.
      block
        local total_width = remaining_size.x
        local total_weight = 0.0
        total_weight += (forEach in unresolved_columns).weight

        forEach (column in writer=unresolved_columns.rewriter)
          if (column.weight)
            local w = total_width * column.weight / total_weight
            if (snap) w .= floor
            remaining_size.x -= w
            column.width = w
          else
            writer.write( column )
          endIf
        endForEach
      endBlock

      # Divide remaining width among remaining unweighted columns
      block
        local remaining_count = unresolved_columns.count

        forEach (column in unresolved_columns)
          local w = remaining_size.x
          if (remaining_count > 1)
            w /= remaining_count
            if (snap) w .= floor
          endIf
          remaining_size.x -= w
          column.width = w
          --remaining_count
        endForEach
      endBlock

    method .resolve_row_heights( unresolved_rows:TableRow[], available_size:XY )
      local snap = UI.snap_to_pixel_coordinates
      local remaining_size = available_size

      # Resolve shrink-to-fit rows by assigning them their min size
      forEach (row in writer=unresolved_rows.rewriter)
        if (row.sizing_mode == SizingMode.SHRINK_TO_FIT)
          row.height = (row.min_height * row.weight).floor
          remaining_size.y -= row.height
        else
          writer.write( row )
        endIf
      endForEach

      if (unresolved_rows.is_empty) return

      # Resolve proportional row heights relative to the total available height
      forEach (row in writer=unresolved_rows.rewriter)
        if (row.sizing_mode == SizingMode.PROPORTIONAL)
          row.height = (row.layout_height * available_size.y)
          if (snap) row.height .= floor
          remaining_size.y -= row.height
        else
          writer.write( row )
        endIf
      endForEach

      if (unresolved_rows.is_empty) return

      # Each remaining unresolved row is expand-to-fill.

      if (this.sizing_mode.y == SizingMode.NATURAL)
        # Natural row height is the min height of the widest row
        local natural_height = 0.0
        natural_height .= or_larger( (forEach in unresolved_rows).min_height )

        local necessary_height = 0.0
        forEach (row in unresolved_rows)
          necessary_height += (natural_height * row.weight).floor
        endForEach

        remaining_size.y .= or_smaller( necessary_height )
      endIf

      # Resolve row heights of rows with min-height too tall for proportional share.
      block
        local repeat = true
        while (repeat)
          repeat = false

          local total_height = remaining_size.y
          local total_weight = 0.0
          total_weight += (forEach in unresolved_rows).weight

          forEach (row in writer=unresolved_rows.rewriter)
            if (row.weight)
              local h = total_height * row.weight / total_weight
              if (snap) h .= floor

              if (row.min_height > h)
                # Component's min height exceeds its share. Assign it its min height
                # and remove it from the list by not rewriting it.
                remaining_size.y -= row.min_height
                row.height = row.min_height
                repeat = true
              else
                writer.write( row )
              endIf
            else
              writer.write( row )
            endIf
          endForEach
        endWhile
      endBlock

      # Resolve row heights of remaining weighted rows.
      block
        local total_height = remaining_size.y
        local total_weight = 0.0
        total_weight += (forEach in unresolved_rows).weight

        forEach (row in writer=unresolved_rows.rewriter)
          if (row.weight)
            local h = total_height * row.weight / total_weight
            if (snap) h .= floor
            remaining_size.y -= h
            row.height = h
          else
            writer.write( row )
          endIf
        endForEach
      endBlock

      # Divide remaining height among remaining unweighted rows
      block
        local remaining_count = unresolved_rows.count

        forEach (row in unresolved_rows)
          local h = remaining_size.y
          if (remaining_count > 1)
            h /= remaining_count
            if (snap) h .= floor
          endIf
          remaining_size.y -= h
          row.height = h
          --remaining_count
        endForEach
      endBlock

    method .resolve_cell_layout_sizes
      # All child cells have their own size set or assigned; have them recursively
      # determine their child sizes.
      forEach (cell in .cells)
        local spanned_size = .spanned_size( cell )
        cell.fixed_size = spanned_size
        cell.resolve_layout_size( spanned_size )
        cell.resolve_content_layout_sizes
      endForEach

    method .spanned_size( cell:TableCell )->XY
      if (cell.span == XY(1,1))
        return cell.size
      endIf

      local sz = (cell.span-XY(1,1)) * gap
      forEach (j in 0..<cell.span.y)
        forEach (i in 0..<cell.span.x)
          if local part = this.cell( cell.index.x+i, cell.index.y+j )
            sz.x += part.size.x
            if (i == 0) sz.y += part.size.y
          endIf
        endForEach
      endForEach
      return sz

    method .determine_row_minmax_height( row:TableRow, available_size:XY )
      local snap = UI.snap_to_pixel_coordinates

      local row_min_h = 0.0
      local row_max_h = available_size.y

      forEach (i in 0..<cells_wide)
        if local cell = cell( i, row.j )
          if local content = cell.first_content_component
            local (min_sz,max_sz) = content.resolve_minmax_layout_size( available_size.xv, available_size, &limited )
            if (cell.span.y > 1)
              min_sz.y /= cell.span.y
              max_sz.y /= cell.span.y
              if (snap) min_sz.y .= ceiling; max_sz.y .= ceiling
            endIf
            row_min_h .= or_larger( min_sz.y )
            row_max_h .= or_smaller( max_sz.y )
          endIf
        endIf
      endForEach

      if (row_min_h > row_max_h) row_max_h = row_min_h
      row.min_height = row_min_h
      row.max_height = row_max_h

    method on_begin_layout
      prior.on_begin_layout
      size_resolved_for = null
      if (h_gap_parameter_id) @gap.x = h_gap_parameter_id->Real
      if (v_gap_parameter_id) @gap.y = v_gap_parameter_id->Real

    method row( j:Int )->TableRow
      if (j < 0 or j >= cells_high) return null
      return rows[j]

    method set( index:XY, component:Component )
      local cell = cell( index.x, index.y )
      if (cell)
        cell.deactivate
        cell.clear
        cell.add( component )
      endIf

    method set_cell( index:XY, cell:TableCell )
      local i = index.x->Int
      local j = index.y->Int
      if (i < 0 or i >= cells_wide)  return
      if (j < 0 or j >= cells_high) return
      local index = j*cells_wide + i
      .cells[index]?.deactivate
      .cells[index] = cell

    method set_gap( @gap )
      h_gap_parameter_id = VariantEntryID(0)
      v_gap_parameter_id = VariantEntryID(0)

    method set_gap( gap:Real ) [override]
      this.gap = XY( gap, gap )

    method set_gap( gap_parameter_id:VariantEntryID ) [override]
      h_gap_parameter_id = gap_parameter_id
      v_gap_parameter_id = gap_parameter_id
      @gap = XY( h_gap_parameter_id->Real, v_gap_parameter_id->Real )

    method set_h_gap( gap:Real ) [override]
      @gap.x = gap
      h_gap_parameter_id = VariantEntryID(0)

    method set_h_gap( h_gap_parameter_id ) [override]
      @gap.x = h_gap_parameter_id->Real

    method set_v_gap( gap:Real ) [override]
      @gap.y = gap
      v_gap_parameter_id = VariantEntryID(0)

    method set_v_gap( v_gap_parameter_id ) [override]
      @gap.y = v_gap_parameter_id->Real

    method update_cell_visibility
      # Update cell visibility settings based on current cell span values
      (forEach in .cells).is_obscured = false

      local index = 0
      forEach (j in 0..<cells_high)
        forEach (i in 0..<cells_wide)
          local cell = .cells[index]
          if (cell.span.product > 1)
            forEach (dj in 0..<cell.span.y)
              forEach (di in 0..<cell.span.x)
                if (di or dj)
                  local obscured_cell = this.cell( i+di,j+dj )
                  obscured_cell.is_obscured = true
                endIf
              endForEach
            endForEach
          endIf
          ++index
        endForEach
      endForEach

endClass

class TableColumns : TableColumn[]
  METHODS
    method fixed_width( w:Real )
      (forEach in this).fixed_width( w )

    method fixed_width( w:PointWidth )
      (forEach in this).fixed_width( w )

    method set_width( w:Real )
      (forEach in this).set_width( w )

    method set_dynamic_width( w:ProportionalWidth )
      (forEach in this).set_dynamic_width( w )

    method set_dynamic_width( w:ShrinkToFit )
      (forEach in this).dynamic_width = w

endClass

class TableColumn( table:Table, i:Int )
  # Specifies table column size
  PROPERTIES
    sizing_mode  = SizingMode.EXPAND_TO_FILL : SizingMode
    layout_width : Real

    width        : Real
    min_width    : Real
    max_width    : Real
    weight       = 1.0

    is_resolved  : Logical

  METHODS
    method cells->TableSubsetProperties
      return TableSubsetProperties( table, i, 0, i, table.cells_high-1 )

    method fixed_width( w:Real )
      sizing_mode  = SizingMode.FIXED_PIXELS
      layout_width = w
      width        = w

    method fixed_width( w:PointWidth )
      sizing_mode  = SizingMode.FIXED_POINTS
      layout_width = w.value
      width        = w.value

    method set_width( @width )
      localize i
      forEach (j in 0..<table.cells_high)
        if local cell = table.cell( i, j )
          cell.fixed_width = width
        endIf
      endForEach

    method set_dynamic_width( w:ExpandToFill )
      sizing_mode = SizingMode.EXPAND_TO_FILL

    method set_dynamic_width( w:ShrinkToFit )
      sizing_mode = SizingMode.SHRINK_TO_FIT

    method set_dynamic_width( w:ProportionalWidth )
      sizing_mode = SizingMode.PROPORTIONAL
      layout_width = w.value

endClass

class TableRows : TableRow[]
  METHODS
    method cells->TableSubsetProperties
      return TableSubsetProperties( table, 0, j, table.cells_wide-1, j )

    method fixed_height( h:Real )
      (forEach in this).fixed_height( h )

    method fixed_height( h:PointHeight )
      (forEach in this).fixed_height( h )

    method set_dynamic_height( h:ExpandToFill )
      (forEach in this).dynamic_height = h

    method set_dynamic_height( h:ShrinkToFit )
      (forEach in this).dynamic_height = h

    method set_dynamic_height( h:ProportionalHeight )
      (forEach in this).dynamic_height = h

    method set_height( height:Real )
      (forEach in this).set_height( height )

endClass

class TableRow( table:Table, j:Int )
  # Specifies table row size
  PROPERTIES
    sizing_mode   = SizingMode.EXPAND_TO_FILL : SizingMode
    layout_height : Real

    height        : Real
    min_height    : Real
    max_height    : Real
    weight        = 1.0

    is_resolved   : Logical

  METHODS
    method cells->TableSubsetProperties
      return TableSubsetProperties( table, 0, j, table.cells_wide-1, j )

    method fixed_height( h:Real )
      sizing_mode  = SizingMode.FIXED_PIXELS
      layout_height = h
      height        = h

    method fixed_height( h:PointHeight )
      sizing_mode  = SizingMode.FIXED_POINTS
      layout_height = h.value
      height        = h.value

    method set_height( @height )
      localize j
      forEach (i in 0..<table.cells_wide)
        if local cell = table.cell( i, j )
          cell.fixed_height = height
        endIf
      endForEach

    method set_dynamic_height( h:ExpandToFill )
      sizing_mode  = SizingMode.EXPAND_TO_FILL

    method set_dynamic_height( h:ProportionalHeight )
      sizing_mode   = SizingMode.PROPORTIONAL
      layout_height = h.value

    method set_dynamic_height( h:ShrinkToFit )
      sizing_mode  = SizingMode.SHRINK_TO_FIT

endClass

class TableCell( index:XY ) : Component
  PROPERTIES
    span        = XY( 1, 1 )
    is_obscured : Logical  # layout helper

  METHODS
    method init_object
      is_pointer_passthrough = true

    method set_span( @span )
      if local table = parent->(as Table)
        table.update_cell_visibility
      endIf

    method to->String
      return "TableCell$"(index)

endClass

class TableSubsetProperties( table:Table, i1:Int, j1:Int, i2:Int, j2:Int ) : ComponentGroupProperties [compound]
  METHODS
    method iterator->TableSubsetPropertiesIterator
      return TableSubsetPropertiesIterator( table, i1, j1, i2, j2, i1 )
endClass

class TableSubsetPropertiesIterator( table:Table, i:Int, j:Int, i2:Int, j2:Int, i1:Int ) [compound]
  METHODS
    method read_another->TableCell? [mutating]
      if (i <= i2 and j <= j2)
        local result = table.cell( i, j )
        ++i
        if (i > i2)
          i = i1
          ++j
        endIf
        return result
      else
        return null
      endIf
endClass
