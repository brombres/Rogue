library UI

uses Collection/Node
uses Control
uses Entity
uses Geometry

$include UI/AbsoluteLayout
$include UI/Aspect
$include UI/AspectRatioLayoutSwitcher
$include UI/Border
$include UI/Component
$include UI/ComponentScript
$include UI/ComponentGroupProperties
$include UI/ComponentSizeInfo
$include UI/DisplayComponents
$include UI/Event
$include UI/Focus
$include UI/Filler
$include UI/Font
$include UI/HBox
$include UI/HFlow
$include UI/Label
$include UI/LimitedSize
$include UI/MetaComponent
$include UI/NaturalSize
$include UI/Overlay
$include UI/Points
$include UI/Proportional
$include UI/ScalingMode
$include UI/SizingMode
$include UI/Spacer
$include UI/Table
$include UI/Text
$include UI/TextBox
$include UI/TextField
$include UI/TextStyle
$include UI/TypedText
$include UI/VBox
$include UI/VList
$include UI/VScrollView
$include UI/Widget

class UI : Component [singleton]
  GLOBAL PROPERTIES
    shared_focus       = Focus()
    display_density_fn = () => 1.0          : Function->Real
    display_size_fn    = () => Console.size : Function->XY

  PROPERTIES
    default_font   : Font
    clip           : Box?
    focus          = shared_focus : Focus

    parameters     : Variant

    needs_layout   = true
    needs_redraw   = true

    snap_to_pixel_coordinates = true

    find_handler   : Function(GlobalID,Variant)->Variant

    scroll_rate    = default_scroll_rate : Real

  METHODS
    method init_object
      UI = this

    method bounds_changed( bounds:Box )->Logical
      return bounds.size != size

    method container( content:Component, &h, &v )->Component [preferred]
      local container = Component()
      if (h xor v)
        if (h) container.fixed_height = 0  # horizontal container has fixed height 0
        else   container.fixed_width  = 0  # vice-versa
      endIf
      container.add( content )
      return container

    method container( content:Component, w=null:Real?, h=null:Real? )->Component
      local container = Component()
      if (w) container.fixed_width = w.value
      if (h) container.fixed_height = h.value
      container.add( content )
      return container

    method default_scroll_rate->Real
      return 5.0

    method display_density->Real
      return display_density_fn()

    method display_size->XY
      return display_size_fn()

    method draw [override]
      UI = this
      prior.draw

    method filler( &h, &v )->Component
      local component = Component().[ weight=0.0 ]
      if (h xor v)
        if (h) component.fixed_height = 0  # horizontal filler has fixed height 0
        else   component.fixed_width  = 0  # vice-versa
      endIf
      return component

    method find( id:GlobalID, arg=undefined:Variant, &up )->Variant [override]
      local result = prior.find( id, arg, &=up )
      if (result.exists)       return result
      if (up and find_handler) return find_handler( id, arg )
      return undefined

    method font->Font
      if (@font) return @font
      return default_font

    method handle( e:KeyEvent )
      UI = this

      if (focus.keyboard)
        if (not focus.keyboard.attributes.intangible)
          focus.keyboard.handle( e )
        else
          focus.keyboard.release_keyboard_focus
          on( e )
          if (e.is_consumed) return
          first_content_component?.dispatch( e )
        endIf
      else
        on( e )
        if (e.is_consumed) return
        first_content_component?.dispatch( e )
      endIf
      if (e.is_consumed) return

      on_unhandled( e )

    method handle( e:PointerEvent )
      UI = this

      on( e )
      if (e.is_consumed) return

      if (focus.pointer)
        if (focus.pointer.yield_pointer_focus_to(e))
          focus.pointer.release_pointer_focus
          first_content_component?.dispatch( e )
        else
          focus.pointer.handle( e )
        endIf
      else
        first_content_component?.dispatch( e )
      endIf
      if (e.is_consumed) return

      on_unhandled( e )

    method handle( e:ScrollEvent )
      UI = this

      on( e )
      if (e.is_consumed) return

      if (focus.pointer)
        focus.pointer.handle( e )
      else
        first_content_component?.dispatch( e )
      endIf
      if (e.is_consumed) return

      on_unhandled( e )

    method handle( e:TextEvent )
      UI = this

      on( e )
      if (e.is_consumed) return

      if (focus.keyboard)
        focus.keyboard.handle( e )
      else
        first_content_component?.dispatch( e )
      endIf
      if (e.is_consumed) return

      on_unhandled( e )

    method on_resize
      # '.size' has changed since the previous update.
      noAction

    method release_keyboard_focus [override]
      if (focus.keyboard)
        if (focus.keyboard is this)
          focus.keyboard = null
          on_release_keyboard_focus
        else
          focus.keyboard.release_keyboard_focus
        endIf
      endIf

    method release_pointer_focus [override]
      if (focus.pointer)
        if (focus.pointer is this)
          focus.pointer = null
          on_release_pointer_focus
        else
          focus.pointer.release_pointer_focus
        endIf
      endIf

    method request_layout [override]
      needs_layout = true

    method request_redraw [override]
      needs_redraw = true

    method set_clip( @clip )
      noAction

    method set_display_density( display_density_fn:Function->Real )
      UI.display_density_fn = display_density_fn

    method set_display_size( display_size_fn:Function->XY )
      UI.display_size_fn = display_size_fn

    method set_needs_layout( @needs_layout )

    method update( bounds:Box )
      UI = this

      # Ensure we've got a layout before the first update().
      # This is a necessary step on first launch and whenever the
      # display size is adjusted between frames.
      update_layout( bounds )

      # Happens every frame
      update

      if (needs_layout)
        # update() has modified the UI, so we need another update_layout().
        update_layout( bounds )
      endIf

    method update_bounds( bounds:Box )
      needs_layout = true
      size = bounds.size
      on_resize

    method update_layout( bounds:Box )
      UI = this

      position = bounds.position
      if (bounds_changed(bounds))
        update_bounds( bounds )
      endIf

      if (needs_layout)
        needs_layout = false
        needs_redraw = true
        begin_layout
        resolve_layout_size( bounds.size )
        perform_layout( position )
        end_layout
      endIf

endClass
