library UI

class DisplayComponents( parent:Component, only_visible=false:Logical ) [compound]
  METHODS
    method on_use->Component[]
      local list = WorkList<<Component>>.on_use
      parent.collect_child_display_components( list, &=only_visible )
      return list

    method on_end_use( list:Component[] )
      WorkList<<Component>>.on_end_use( list )
endClass
