library UI

class TypedText : Text
  GLOBAL PROPERTIES
    default_reveal_rate  = 60.0

  PROPERTIES
    reveal_rate          = default_reveal_rate : Real
    revealed_count       = 0.0
    is_typed_text_active = false
    reveal_next          = true

  METHODS
    method copy_settings_from( other:Component ) [override]
      prior.copy_settings_from( other )
      if local other_typed_text = other->(as TypedText)
        @reveal_rate = other_typed_text.reveal_rate
        @reveal_next = other_typed_text.reveal_next
      endIf

    method create_fragment( text:String, i1=0:Int, n=undefined:Int? )->$thisType [propagated]
      if (not n) n = text.count
      if (i1 > 0 or n.value < text.count) text = text.substring( i1, n.value )

      local result = new<<$thisType>>
      result->(as Text).init( text, &fragment )
      result.copy_settings_from( this )

      if (revealed_count > i1)
        result.revealed_count = (revealed_count - i1).or_larger( n.value )
        result.is_typed_text_active = true
      endIf

      return result

    method is_revealed->Logical [novel]
      if local last_fragment = last_child->(as TypedText)
        return last_fragment.is_revealed
      else
        return revealed_count == value.count
      endIf

    method on_draw [override]
      if (not value) return

      localize font
      local text_size = font.measure( value )
      local revealed_bounds = snapped(
        Box(
          Box(text_size).positioned_within( bounds, content_alignment ).position,
          text_size
        )
      )

      use temp_value = StringPool
        forEach (i in 0..<revealed_count->Int)
          temp_value.print( value[i] )
        endForEach

        temporarily @value = temp_value
          temporarily content_alignment = Anchor.TOP_LEFT
            temporarily font.anchor = Anchor.TOP_LEFT
              temporarily position = revealed_bounds.position
                prior.on_draw
              endTemporarily
            endTemporarily
          endTemporarily
        endTemporarily
      endUse

    method on_update [override]
      if (not is_typed_text_active or not value) return

      if local child = first_child->(as TypedText)
        # This TypedText was activated before it got split into fragments. Activate its first child.
        is_typed_text_active = false
        child.start_typing
      endIf

      if (is_revealed)
        is_typed_text_active = false
        if (reveal_next) .activate_next
      else
        revealed_count = (revealed_count + reveal_rate*Window.dt).clamped_high( value.count )
      endIf

    method reset( progress=0.0:Real )
      if local first_fragment = first_child->(as TypedText)
        forEach (child as TypedText in children) child.reset
      else
        is_typed_text_active = false
      endIf

      reveal( progress )

    method restart
      reset
      if local first_fragment = first_child->(as TypedText)
        first_fragment.restart
      else
        is_typed_text_active = true
      endIf

    method reveal( progress=1.0:Real )
      if (first_child)
        local child_sum = 0.0
        child_sum += (forEach as TypedText in children).value.count

        if (child_sum)
          local remaining_p = progress
          forEach (child as TypedText in children)
            local child_p = child.value.count / child_sum
            if (remaining_p <= child_p)
              child.reveal( remaining_p )
              remaining_p = 0.0
            else
              child.reveal( 1.0 )
              remaining_p -= child_p
            endIf
          endForEach
        endIf
      else
        revealed_count = progress * value.count
      endIf

    method set_reveal_next( @reveal_next )
      forEach (child as TypedText in children) child.reveal_next = reveal_next

    method set_value( new_value:String ) [override]
      local is_modified = (new_value != value)

      prior.set_value( new_value )

      if (is_modified)
        is_typed_text_active = false
        revealed_count = 0.0
      endIf

    method start_typing( reveal_next=true ) [novel]
      .activate_next

    method stop_typing( &rewind )
      is_typed_text_active = false
      if (rewind) reveal( 0 )

    method .activate_next [novel]
      local query_fn = function( entity:Entity )->Logical
        if local typed_text = entity->(as TypedText)
          if (typed_text.first_child) return false
          if (not typed_text.is_revealed) return true
        endIf
        return false
      endFunction

      local cur = this : Text
      while (cur and cur.parent)
        if local parent_text = cur.parent->(as Text)
          cur = parent_text
        else
          escapeWhile
        endIf
      endWhile

      if local next_typed_text = cur.find( query_fn )->(as TypedText)

        if (not reveal_next)
          # Make sure next_typed_text is this or a fragment of this.
          if (not (next_typed_text is this or next_typed_text.has_ancestor(this)))
            return
          endIf
        endIf

        next_typed_text.is_typed_text_active = true
      endIf

endClass

