library UI

class Padding( value:Real, mode:SizingMode ) [compound]
  GLOBAL METHODS
    method create( value:Real, &proportional )->Padding
      if (proportional) return Padding.proportional( value )
      else              return fixed( value )

    method create( parameter_id:VariantEntryID )->Padding
      return Padding( parameter_id.value, SizingMode.PARAMETER_REAL )

    method create( points:Points )->Padding
      return Padding( points.value, SizingMode.FIXED_POINTS )

    method fixed( value:Real )->Padding
      return Padding( value, SizingMode.FIXED_PIXELS )

    method proportional( value:Real )->Padding
      return Padding( value, SizingMode.PROPORTIONAL )

  METHODS
    method resolved_value( available_size:Real )->Real
      local result : Real

      which (mode)
        case PARAMETER_REAL
          result = value->Int->VariantEntryID->Real
        case PROPORTIONAL
          result = available_size * value
        case FIXED_POINTS
          result = value * UI.display_density
        others
          result = value
      endWhich

      if (UI.snap_to_pixel_coordinates) result .= floor
endClass

class Border : Component
  PROPERTIES
    left_padding    : Padding
    top_padding     : Padding
    right_padding   : Padding
    bottom_padding  : Padding
    left_px, top_px, right_px, bottom_px : Real  # current pixel values derived from 'left_padding' etc.

  METHODS
    method content_size_to_layout_size( content_size:XY )->XY
      return content_size + XY(left_px+right_px,top_px+bottom_px)

    method content_position->XY
      return XY(left_px,top_px)

    method content_size->XY
      return (size - XY(left_px+right_px,top_px+bottom_px)).clamped_low(XY(0,0))

    method resolve_layout_size( available_size:XY, &limited )->XY [override]
      left_px = left_padding.resolved_value( available_size.x )
      top_px = top_padding.resolved_value( available_size.y )
      right_px = right_padding.resolved_value( available_size.x )
      bottom_px = bottom_padding.resolved_value( available_size.y )
      return prior.resolve_layout_size( available_size, &=limited )

    method set_horizontal_padding( padding:Padding )
      left_padding = padding
      right_padding = padding

    method set_vertical_padding( padding:Padding )
      top_padding = padding
      bottom_padding = padding

    method set_padding( padding:Padding )
      left_padding   = padding
      right_padding  = padding
      top_padding    = padding
      bottom_padding = padding

endClass
