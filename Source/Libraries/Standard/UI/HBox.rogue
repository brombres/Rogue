library UI

class HBox : Component
  PROPERTIES
    gap              : Real  # In pixels
    gap_parameter_id : VariantEntryID

  METHODS
    method init_object
      is_pointer_passthrough = true

    method minimum_layout_size( available_size:XY, &limited )->XY [override]
      local w = 0.0
      local h = 0.0
      use components = display_components
        forEach (component at i in components)
          local sz = component.resolve_layout_size( available_size.yv, &=limited )
          if (i) w += gap
          w += sz.x
          h .= or_larger( sz.y )
        endForEach
      endUse
      return XY(w,h)

    method perform_content_layout [override]
      localize anchor
      local total_w = 0.0
      local h = 0.0
      use components = display_components

        forEach (component at i in components)
          local sz = component.size
          if (i) total_w += gap
          total_w += sz.x
          h .= or_larger( sz.y )
        endForEach

        local pos = XY.zero
        pos.x = snapped( Box(XY(total_w,h)).positioned_within( content_bounds, anchor ).position.x )
        forEach (component in components)
          component.perform_layout(
            snapped(
              component.bounds.positioned_within(
                Box(pos,component.size.x,size.y),
                component.anchor
              ).position
            )
          )
          pos.x += component.size.x + gap
        endForEach
      endUse

    method resolve_content_layout_sizes( available_size:XY ) [override]
      use components = display_components
        if (components.count > 1)
          available_size.x = (available_size.x - (components.count - 1) * gap).clamped_low( 0 )
        endIf

        use info_list = WorkList<<ComponentSizeInfo>>

          # Determine the min & max widths of all child components.
          local total_weight : Real
          forEach (component in components)
            local (min_size,max_size) =
              component.resolve_minmax_layout_size( available_size.yv, available_size, &limited )
            if (min_size.x == max_size.x)
              available_size.x -= min_size.x
            else
              total_weight += component.weight.x
              info_list.add( ComponentSizeInfo(component, &=min_size, &=max_size) )
            endIf
          endForEach

          if (total_weight == 0) total_weight = 1.0

          local snap = UI.snap_to_pixel_coordinates

          block
            local repeat = true
            while (repeat)
              repeat = false
              local total_width = available_size.x
              forEach (info in rewriter=info_list.rewriter)
                local w = total_width * info.component.weight.x / total_weight
                if (snap) w .= floor
                if (info.max_size.x < w)
                  # Component's max size falls short of its share. Let it keep its max size and
                  # remove it from the list by not rewriting it.
                  info.component.size.x = info.max_size.x
                  info.component.attributes.constant_width = true
                  available_size.x -= info.max_size.x
                  total_weight -= info.component.weight.x
                  if (total_weight == 0) total_weight = 1.0
                  repeat = true
                elseIf (info.min_size.x > w)
                  # Component's min size exceeds its share. Assign it its min size,
                  # re-resolve its size to allow width to adjust accordingly, and
                  # remove it from the list by not rewriting it.
                  info.component.size.x = info.min_size.x
                  info.component.attributes.constant_width = true
                  info.component.resolve_layout_size( XY(info.min_size.x,available_size.y), &limited )
                  available_size.x -= info.min_size.x
                  total_weight -= info.component.weight.x
                  if (total_weight == 0) total_weight = 1.0
                  repeat = true
                else
                  # Component can size at least as big as its proportional share; keep it for the next pass.
                  rewriter.write( info )
                endIf
              endForEach
            endWhile
          endBlock

          # Assign remaining weighted components their proportional share of available width.
          block
            local remaining_width = available_size.x
            forEach (info in info_list)
              if (info.component.weight.x)
                local w = available_size.x * info.component.weight.x / total_weight
                if (snap) w .= floor
                info.component.size.x = w
                remaining_width -= w
              else
                # Set zero-weight component width to 0 for now.
                info.component.size.x = 0
              endIf
              info.component.attributes.constant_width = true
              info.component.resolve_layout_size( XY(info.component.size.x,available_size.y), &limited )
            endForEach

            if (remaining_width)
              # Treat remaining unweighted components as being equally weighted and
              # assign them a proportional share of remaining width.
              total_weight = 0
              if ((forEach in info_list).component.weight.x == 0) ++total_weight

              local remaining_count = info_list.count( $.component.weight.x == 0 )
              forEach (info in info_list)
                if (info.component.weight.x == 0)
                  local w = remaining_width
                  if (remaining_count > 1)
                    w = w / total_weight
                    --total_weight
                    if (snap) w .= floor
                  endIf
                  info.component.size.x = w
                  info.component.resolve_layout_size( XY(w,available_size.y), &limited )
                  remaining_width -= w
                  --remaining_count
                endIf
              endForEach

            endIf
          endBlock

        endUse

        # All child components have their own size set or assigned; have them recursively
        # determine their child sizes. Before now each component's resolve_layout_size()
        # has only been called in a &limited fashion; call it once more, non-&limited,
        # to ensure that on_layout_size_resolved() fires.
        forEach (component in components)
          component.resolve_layout_size( XY(component.size.x,available_size.y) )
          component.resolve_content_layout_sizes
        endForEach
      endUse

    method on_begin_layout
      prior.on_begin_layout
      if (gap_parameter_id)
        @gap = gap_parameter_id->Real
      endIf

    method set_gap( @gap ) [override]
      @gap_parameter_id = VariantEntryID(0)

    method set_gap( gap_parameter_id )
      @gap = gap_parameter_id->Real

    method set_h_gap( gap:Real )
      set_gap( gap )

    method set_h_gap( parameter_id:VariantEntryID )
      set_gap( parameter_id )
endClass

class UIGeneratedHBox : HBox
  # Special subclass for operator overrides
  METHODS
    method operator+( rhs:Component )->Component [override]
      add( rhs )
      return this

endClass
