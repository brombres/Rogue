library UI

class LimitedSize : Component
  PROPERTIES
    minimum_width   : Real?
    minimum_height  : Real?
    maximum_width   : Real?
    maximum_height  : Real?
    is_points       : Logical  # limits are in point values, not pixel values
    is_proportional : Logical  # limits are proportional to display size (if set, is_points is ignored)

    minimum_aspect_width  : Logical
    minimum_aspect_height : Logical
    maximum_aspect_width  : Logical
    maximum_aspect_height : Logical
    aspect_limit          : XY?

  METHODS
    method minimum_aspect_width( aspect_limit )
      minimum_aspect_width = true

    method minimum_aspect_height( aspect_limit )
      minimum_aspect_height = true

    method maximum_aspect_width( aspect_limit )
      maximum_aspect_width = true

    method maximum_aspect_height( aspect_limit )
      maximum_aspect_height = true

    method points
      is_points = true

    method proportional
      is_proportional = true

    method set_maximum_height( height:Real )
      @maximum_height  = height

    method set_maximum_size( size:XY )
      @maximum_width   = size.x
      @maximum_height  = size.y

    method set_maximum_width( width:Real )
      @maximum_width   = width

    method set_minimum_height( height:Real )
      @minimum_height  = height

    method set_minimum_size( size:XY )
      @minimum_width   = size.x
      @minimum_height  = size.y

    method set_minimum_width( width:Real )
      @minimum_width   = width

    method resolve_layout_size( available_size:XY, &limited )->XY [override]
      local snap = (UI.snap_to_pixel_coordinates)

      if (is_proportional)
        local display_size = UI.display_size
        if (minimum_width)  available_size.x .= clamped_low( minimum_width.value * display_size.x )
        if (minimum_height) available_size.y .= clamped_low( minimum_height.value * display_size.y )
        if (maximum_width)  available_size.x .= clamped_high( maximum_width.value * display_size.x )
        if (maximum_height) available_size.y .= clamped_high( maximum_height.value * display_size.y )
      else
        local density = which{ is_points:UI.display_density || 1.0 }
        if (minimum_width)  available_size.x .= clamped_low( minimum_width.value * density )
        if (minimum_height) available_size.y .= clamped_low( minimum_height.value * density )
        if (maximum_width)  available_size.x .= clamped_high( maximum_width.value * density )
        if (maximum_height) available_size.y .= clamped_high( maximum_height.value * density )
      endIf

      if local aspect_limit = aspect_limit
        if (minimum_aspect_width)
          available_size.y .= clamped_high( (available_size.x / aspect_limit.x) * aspect_limit.y )
        endIf
        if (minimum_aspect_height)
          available_size.x .= clamped_high( (available_size.y / aspect_limit.y) * aspect_limit.x )
        endIf
        if (maximum_aspect_width)
          available_size.x .= clamped_high( (available_size.y / aspect_limit.y) * aspect_limit.x )
        endIf
        if (maximum_aspect_height)
          available_size.y .= clamped_high( (available_size.x / aspect_limit.x) * aspect_limit.y )
        endIf
      endIf

      if (snap) available_size .= floor

      local sz = prior.resolve_layout_size( available_size, &=limited )

      if (is_proportional)
        local display_size = UI.display_size
        if (minimum_width)  sz.x .= clamped_low( minimum_width.value * display_size.x )
        if (minimum_height) sz.y .= clamped_low( minimum_height.value * display_size.y )
        if (maximum_width)  sz.x .= clamped_high( maximum_width.value * display_size.x )
        if (maximum_height) sz.y .= clamped_high( maximum_height.value * display_size.y )
      else
        local density = which{ is_points:UI.display_density || 1.0 }
        if (minimum_width)  sz.x .= clamped_low( minimum_width.value * density )
        if (minimum_height) sz.y .= clamped_low( minimum_height.value * density )
        if (maximum_width)  sz.x .= clamped_high( maximum_width.value * density )
        if (maximum_height) sz.y .= clamped_high( maximum_height.value * density )
      endIf

      if local aspect_limit = aspect_limit
        if (minimum_aspect_width)
          sz.y .= clamped_high( (sz.x / aspect_limit.x) * aspect_limit.y )
        endIf
        if (minimum_aspect_height)
          sz.x .= clamped_high( (sz.y / aspect_limit.y) * aspect_limit.x )
        endIf
        if (maximum_aspect_width)
          sz.x .= clamped_high( (sz.y / aspect_limit.y) * aspect_limit.x )
        endIf
        if (maximum_aspect_height)
          sz.y .= clamped_high( (sz.x / aspect_limit.x) * aspect_limit.y )
        endIf
      endIf

      if (snap) sz .= floor
      size = sz

      return sz

endClass
