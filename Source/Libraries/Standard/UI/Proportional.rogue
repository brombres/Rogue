library UI

uses Geometry

class Proportional( value:Real ) [compound]
  # A size in logical (density-independent) coordinates. Automatically
  # multiplied by UI.display_density when converted to pixels.
  METHODS
    method to->Real
      return value
endClass

class ProportionalXY( value:XY ) [compound]
  # A size in logical (density-independent) coordinates. Automatically
  # multiplied by UI.display_density when converted to pixels.
  GLOBAL METHODS
    method create( x:Real, y:Real )->ProportionalXY
      return ProportionalXY( XY(x,y) )

  METHODS
    method to->XY
      return value
endClass
