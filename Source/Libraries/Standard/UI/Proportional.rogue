library UI

uses Geometry

class Proportional( value:Real ) [compound]
  # A size expressed as a fraction of the available size or of a
  # reference component's size.
  METHODS
    method to->Real
      return value
endClass

class ProportionalXY( value:XY ) [compound]
  # A size expressed as a fraction of the available size or of a
  # reference component's size.
  GLOBAL METHODS
    method create( x:Real, y:Real )->ProportionalXY
      return ProportionalXY( XY(x,y) )

  METHODS
    method to->XY
      return value
endClass
