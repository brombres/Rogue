$include Control

class ActiveState<<$ExtendedType>>
  GLOBAL METHODS
    method operator+( a:$ExtendedType, b:$ExtendedType )->$ExtendedType
      if (not a) return b
      if (not b) return a
      return a.and_then( b )

    method operator|( a:$ExtendedType, b:$ExtendedType )->$ExtendedType
      if (not a) return b
      if (not b) return a
      return a.also( b )

  PROPERTIES
    next_state       : $ExtendedType
    concurrent_state : $ExtendedType

    is_started  : Logical
    is_exited   : Logical # flag that assists when states finish outside of updated()

  METHODS
    method and_then( state:$ExtendedType )->$ExtendedType
      if (state)
        local cur = this
        while (cur.next_state) cur = cur.next_state
        cur.next_state = state
      endIf
      return this->(as $ExtendedType)

    method and_then_also( state:$ExtendedType )->$ExtendedType
      if (next_state) next_state = next_state.also( state )
      else      next_state = state
      return this->(as $ExtendedType)

    method also( state:$ExtendedType )->$ExtendedType
      if (state)
        local cur = this
        while (cur.concurrent_state) cur = cur.concurrent_state
        cur.concurrent_state = state
      endIf
      return this->(as $ExtendedType)

    method call<<$method_name>>()
      # Calls specified method on this state and all concurrent states.
      this->(as $ExtendedType).$method_name()
      local cur = concurrent_state
      while (cur)
        cur.$method_name()
        cur .= concurrent_state
      endWhile

    method call<<$method_name,$ArgType>>( arg:$ArgType )
      # Calls specified method on this state and all concurrent states.
      this->(as $ExtendedType).$method_name( arg )
      local cur = concurrent_state
      while (cur)
        cur.$method_name( arg )
        cur .= concurrent_state
      endWhile

    method change( new_state:$ExtendedType )
      next_state = new_state
      exit

    method count->Int32
      local n = 1
      if (next_state) n += next_state.count
      if (concurrent_state) n += concurrent_state.count
      return n

    method describe->String
      return type_name

    method description->String
      local result = describe
      if (next_state) result = "$ + $" (result,next_state->String)
      if (concurrent_state) result = "($) | ($)" (result,concurrent_state)
      return result

    method exit
      is_exited = true
      finish

    method find_active<<$FindType>>()->$ExtendedType
      # Returns any active state (this or a concurrent_state) that is
      # instanceOf $FindType.
      local cur = this->(as $ExtendedType)
      while (cur)
        if (cur instanceOf $FindType) return cur
        cur .= concurrent_state
      endWhile
      return null

    method finish
      is_exited = true

    method handle_activate
      on_activate

    method handle_deactivate
      on_deactivate

    method handle_finish
      on_finish
      handle_deactivate

    method insert_next( state:$ExtendedType )
      if (state) next_state = state.and_then( next_state )

    method is_finished->Logical
      return is_exited

    method last->$ExtendedType
      # Returns the last state in this chain
      local cur = this
      while (cur.next_state ) cur = cur.next_state
      return cur

    method on_activate
      # In an ActivateState, on_activate() and on_start() are both always called.
      # In a ProgressState or Action, on_activate() is always called but on_start()
      # is not called if the action is an instant action defining on_execute().
      noAction

    method on_deactivate
      noAction

    method on_start
      noAction

    method on_update
      noAction

    method on_finish
      noAction

    method removing( state:$ExtendedType )->$ExtendedType
      if (this is state)
        return next_state | concurrent_state
      else
        if (next_state)       next_state .= removing( state )
        if (concurrent_state)
          concurrent_state .= removing( state )
        endIf
        return this
      endIf

    method start
      is_started = true
      on_start

    method started->$ExtendedType
      if (is_exited)
        # Already exited outside of updated()
        if (concurrent_state)
          concurrent_state = concurrent_state.started
        endIf

        return this->(as $ExtendedType)
      else
        if (not is_started)
          handle_activate
          start
        endIf

        if (concurrent_state) concurrent_state = concurrent_state.started
        if (not is_finished) return this->(as $ExtendedType)
        handle_finish

        return .start_next
      endIf

    method to->String
      return description

    method update
      on_update

    method updated->$ExtendedType
      if (is_exited)
        # Already exited outside of updated()
        if (concurrent_state)
          concurrent_state = concurrent_state.updated
        endIf
      else
        if (not is_started)
          handle_activate
          start
        endIf

        update

        if (concurrent_state)
          concurrent_state = concurrent_state.updated
        endIf

        if (not is_finished) return this->(as $ExtendedType)
      endIf

      handle_finish

      return .update_next

    method .start_next->$ExtendedType
      # Finds the successor to this state, adjusts links if necessary, and
      # returns it or the result of a call to its started().
      if (next_state)
        if (concurrent_state)
          # Attach any parallel commands remaining in this finished command to the
          # next_state command in this chain that will be the new head.
          next_state = next_state.also( concurrent_state )
          concurrent_state = null
        endIf
        if (.get_top_level_state is this) .set_top_level_state( next_state )
        return next_state.started
      elseIf (concurrent_state)
        # .start_next() is called after updated(), which has already started 'concurrent_state'.
        return concurrent_state
      else
        return null
      endIf

    method .update_next->$ExtendedType
      # Finds the successor to this state, adjusts links if necessary, and
      # returns it or the result of a call to its updated().
      if (next_state)
        if (concurrent_state)
          # Attach any parallel commands remaining in this finished command to the
          # next_state command in this chain that will be the new head.
          next_state = next_state.also( concurrent_state )
          concurrent_state = null
        endIf
        if (.get_top_level_state is this) .set_top_level_state( next_state )
        return next_state.updated
      elseIf (concurrent_state)
        # .update_next() is called after updated(), which has already updated 'concurrent_state'.
        return concurrent_state
      else
        return null
      endIf

    method .get_top_level_state->$ExtendedType
      # Override in subclasses that need to maintain a singleton or other external reference
      # to the state being updated.
      return null

    method .set_top_level_state( state:$ExtendedType )
      # Override in subclasses that need to maintain a singleton or other external reference
      # to the state being updated.
      noAction

endClass

