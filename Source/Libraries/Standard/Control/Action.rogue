$include Control/ActiveState

class Action : ProgressState<<Action>>
  GLOBAL PROPERTIES
    global_timescale = 1.0

  PROPERTIES
    timescale = 1.0


  METHODS
    method on_draw
      noAction

    method on_draw_over
      noAction

    method replace_action( new_action:Action )
      change( new_action )

    method timescale->Real [override]
      return global_timescale * @timescale
endClass
